---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChatLauncher from '../components/ChatLauncher.astro';
import TrialBar from '../components/TrialBar.astro';
import { SITE } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  path: string;              // canonical path, e.g. "/pricing"
  ogImage?: string;          // absolute path under /public, e.g. "/og/pricing.png"
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: object[];         // JSON-LD blocks
  active?: string;           // nav item to highlight
  minimal?: boolean;         // account pages: slimmer chrome
  chat?: boolean;            // the customer help chat (off on admin)
  promo?: boolean;           // the free-trial bar (off on admin and on the trial page itself)
  overlay?: boolean;         // nav floats over a full-screen scene (home)
  lang?: 'en' | 'ar';        // page language (Arabic pages are right-to-left)
  alternates?: { en?: string; ar?: string }; // the same page in the other language (paths)
}
const { title, description, path, ogImage = '/og-image.jpg', ogType = 'website', noindex = false, schema = [], active = '', minimal = false, chat = true, promo = true, overlay = false, lang = 'en', alternates = {} } = Astro.props;
const canonical = SITE.url + (path === '/' ? '/' : path);
const ogUrl = SITE.url + ogImage;
// hreflang: every page lists itself and its translation; x-default is the English page
const alt = { ...alternates, [lang]: path };
const hreflang = Object.entries(alt).filter(([, p]) => p).map(([l, p]) => ({ l, href: SITE.url + (p === '/' ? '/' : p) }));
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hreflang.length > 1 && hreflang.map((h) => <link rel="alternate" hreflang={h.l} href={h.href} />)}
  {hreflang.length > 1 && <link rel="alternate" hreflang="x-default" href={(hreflang.find((h) => h.l === 'en') || hreflang[0]).href} />}
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta name="theme-color" content={SITE.themeColor} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- All three faces appear above the fold (italic: the accent words in headlines) -->
  <link rel="preload" href="/fonts/cormorant-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/cormorant-italic-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jost-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
  <meta property="og:site_name" content="StainBoost" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>document.documentElement.classList.add('js');</script>
  <!-- free trial (timer set in /admin): show it before first paint if it was running last time; /api/status confirms -->
  <script is:inline>try { var t = JSON.parse(localStorage.getItem('sb_trial_v1') || 'null'); if (t && t.endsAt > Date.now()) document.documentElement.classList.add('trial-on'); } catch (e) {}</script>
  <!-- Google Analytics: queued immediately, gtag.js loaded once the page is idle (keeps it off the critical path) -->
  <script is:inline define:vars={{ gaId: SITE.gaId }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', gaId);
    var loadGA = function () {
      var s = document.createElement('script'); s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    };
    // Only the real site reports to GA (local previews never pollute the data).
    if (/(^|\.)stainboost\.com$/.test(location.hostname)) {
      addEventListener('load', function () { ('requestIdleCallback' in window) ? requestIdleCallback(loadGA, { timeout: 2500 }) : setTimeout(loadGA, 1200); });
    }
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
  <slot name="head" />
</head>
<body class={minimal ? 'is-minimal' : ''}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="backdrop" aria-hidden="true"></div>
  {overlay ? (
    <div class="chrome-overlay">
      {promo && <TrialBar />}
      <Nav active={active} overlay lang={lang} alternates={alternates} />
    </div>
  ) : (
    <>
      {promo && <TrialBar />}
      <Nav active={active} lang={lang} alternates={alternates} />
    </>
  )}
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <slot name="after" />
  {chat && <ChatLauncher lang={lang} />}
  <script>
    import '../scripts/common.js';
  </script>
</body>
</html>
