---
import Base from '../layouts/Base.astro';
import ClimbQuote from '../components/ClimbQuote.astro';
import StatusChip from '../components/StatusChip.astro';
import ReviewCard from '../components/ReviewCard.astro';
import FaqList from '../components/FaqList.astro';
import Guarantees from '../components/Guarantees.astro';
import StickyOrderBar from '../components/StickyOrderBar.astro';
import { getCollection } from 'astro:content';
import { STATS, ACCOUNTS, PROOF, DISCORD } from '../data/site.js';
import { lowestWinPrice, formatUSD, rankBoostTotal, LP_OPTIONS } from '../data/pricing.js';
import { getVerifiedReviews } from '../data/reviews.js';
import { TOP_FAQ } from '../data/faq.js';
import { organization, website, boostProduct } from '../data/schema.js';
import { FREE_TRIAL, TRIAL_ENDS_MS } from '../data/promo.js';
import '../styles/home.css';

const reviews = await getVerifiedReviews();
const posts = await getCollection('blog', (p) => !p.data.draft);
const teasers = ['elo-boosting-safe', 'duo-boost-vs-solo-boost', 'master-yi-build-guide'].map((id) => posts.find((p) => p.id === id)).filter(Boolean);
const fromWin = formatUSD(lowestWinPrice());
const trialOn = Date.now() < TRIAL_ENDS_MS;
const heroPrice = formatUSD(rankBoostTotal({ fromTier: 2, fromDiv: 2, toTier: 3, toDiv: 0, type: 'solo', lp: LP_OPTIONS[0].value }));
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base
  title="StainBoost – #1 ELO Boosting on the Middle East Server"
  description={`League of Legends ELO boosting on the Middle East server, played personally by Stain — #1 Master Yi on ME. ${STATS.ordersCompleted}+ orders, 0 bans, full refund if not started. Get an instant price.`}
  path="/"
  overlay
  schema={[organization(), website(), boostProduct(reviews)]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/scene/scene.avif" type="image/avif" fetchpriority="high" />
  </Fragment>

  <!-- ── The scene ──────────────────────────────────────────────────────── -->
  <section class="scene" data-scene data-loc="hero">
    <div class="stage" aria-hidden="true">
      <picture>
        <source srcset="/img/scene/scene.avif" type="image/avif" />
        <img class="photo" src="/img/scene/scene.webp" width="1215" height="717" alt="" fetchpriority="high" decoding="async" data-photo />
      </picture>
      <div class="shade"></div>
      <canvas class="fx" data-fx></canvas>
    </div>

    <div class="copy">
      <StatusChip onlineOnly />
      <p class="eyebrow a1">Challenger · #1 Master Yi · <span class="long">Middle East</span><span class="short">ME</span></p>
      <h1 class="a1"><span class="nowrap">Climb with the</span> <em>#1&nbsp;Master&nbsp;Yi.</em></h1>
      <p class="lede a2">Every game is played by Stain himself — one Challenger player, never a pool of boosters. Offline mode and a VPN on every order.</p>
      <div class="act a3">
        <a class="btn btn-primary btn-lg" href="#price" data-track="cta_click" data-track-location="hero">See my price <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={arrow} /></a>
        {trialOn && (
          <a class="btn-link more" href="/free-trial" data-trial data-track="cta_click" data-track-location="hero_trial">Try {FREE_TRIAL.games} games free <small data-trial-countdown data-end={TRIAL_ENDS_MS} data-prefix="· ends in ">· 2 days only</small></a>
        )}
        <a class="btn-link more" href="/pricing?mode=wins" data-trial-over={trialOn ? '' : undefined} data-track="cta_click" data-track-location="hero_wins">Net wins from {fromWin}</a>
      </div>
    </div>

    <ul class="notes" aria-label="Track record">
      <li class="note"><small>Orders</small><span>{STATS.ordersCompleted}+ completed</span></li>
      <li class="note"><small>Bans</small><span>Zero, ever</span></li>
      <li class="note"><small>Refund</small><span>In full, if not started</span></li>
    </ul>

    <p class="foot start"><b>Stain</b> &nbsp;Challenger · {STATS.masteryPoints} Yi mastery</p>
    <span class="scroll-cue" aria-hidden="true"></span>
    <p class="foot end">Net wins from <b>{fromWin}</b> · pay for 5, get 6</p>
  </section>

  <!-- ── Numbers ────────────────────────────────────────────────────────── -->
  <section class="numbers" aria-label="StainBoost in numbers">
    <div class="wrap nums">
      <div class="n reveal"><span class="num">{STATS.ordersCompleted}+</span><span class="label">Orders completed</span></div>
      <div class="n reveal" style="--d:.08s"><span class="num">{STATS.bans}</span><span class="label">Bans, ever</span></div>
      <div class="n reveal" style="--d:.16s"><span class="num">{STATS.masteryPoints}</span><span class="label">Yi mastery · all accounts</span></div>
      <a class="n reveal" style="--d:.24s" href={PROOF.peak.source} target="_blank" rel="noopener" data-track="proof_click" data-track-location="stats">
        <span class="num"><em>{PROOF.peak.tier}</em></span><span class="label">Rank · see OP.GG ↗</span>
      </a>
    </div>
  </section>

  <!-- ── Instant price ──────────────────────────────────────────────────── -->
  <section class="section price-sec" id="price" data-loc="price">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Instant price</p>
        <h2>Your rank, <em>priced in seconds.</em></h2>
        <p class="lead">Pick where you are and where you want to be. The price you see is the price you pay — and it's refunded in full if the boost hasn't started.</p>
        <ul class="ticks">
          <li>Pay after ordering, with PayPal or Binance Pay</li>
          <li>Net wins from {fromWin} — pay for 5, get 6</li>
          <li>Every game live on your own order page</li>
        </ul>
      </div>
      <div class="reveal" style="--d:.1s"><ClimbQuote /></div>
    </div>
  </section>

  <!-- ── One player ─────────────────────────────────────────────────────── -->
  <section class="section" data-loc="compare">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">Why it's different</p>
        <h2>One player. <em>Not a pool.</em></h2>
        <p>Most boosting sites hand your account to whoever is free. Here, it's always the same player — and you can look him up.</p>
      </div>
      <div class="compare reveal">
        <div class="col them">
          <p class="col-title">A typical boosting site</p>
          <ul>
            <li>A random booster from a pool plays your account</li>
            <li>You rarely know who is logged in</li>
            <li>Questions go through a support desk</li>
          </ul>
        </div>
        <div class="col us">
          <p class="col-title">StainBoost</p>
          <ul>
            <li>Every game is played by <strong>Stain</strong>, #1 Master Yi on ME</li>
            <li>You know exactly who: his accounts are <a href={ACCOUNTS[0].opgg} target="_blank" rel="noopener">public on OP.GG</a></li>
            <li>You chat with Stain himself, on your order page and Discord</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works ───────────────────────────────────────────────────── -->
  <section class="section" data-loc="how">
    <div class="wrap split how">
      <div>
        <div class="section-head reveal">
          <p class="eyebrow">How it works</p>
          <h2>Ordered in two minutes. <em>Tracked every game.</em></h2>
        </div>
        <ol class="steps">
          <li class="reveal"><span class="step-n">I</span><div><h3>Pick your climb</h3><p>Your current and target rank — or a number of net wins — solo or duo. The price you see is the price you pay.</p></div></li>
          <li class="reveal" style="--d:.08s"><span class="step-n">II</span><div><h3>Pay &amp; say hi</h3><p>PayPal or Binance Pay — or message <strong>{DISCORD.handle}</strong> on Discord for another way. He usually replies within minutes.</p></div></li>
          <li class="reveal" style="--d:.16s"><span class="step-n">III</span><div><h3>Watch it climb</h3><p>Your order page shows every game live — rank, LP, results, notes and a direct chat with Stain.</p></div></li>
        </ol>
      </div>
      <div class="preview reveal" style="--d:.1s" aria-label="Example of the live order tracker">
        <div class="screen card">
          <p class="screen-tag">Live tracker · example</p>
          <div class="track-head">
            <div><p class="tok">SB-XXXX-XXXX</p><p class="route">Silver II → Gold IV</p></div>
            <span class="pill pill-in_progress">In progress</span>
          </div>
          <div class="bar-lbl"><span>Rank progress</span><span>Silver I · 62 LP</span></div>
          <div class="bar"><div class="bar-fill"></div></div>
          <ul class="games">
            <li><span class="w">W</span><span>Master Yi<small>13 / 2 / 6</small></span><b>+24 LP</b></li>
            <li><span class="w">W</span><span>Master Yi<small>9 / 3 / 11</small></span><b>+23 LP</b></li>
          </ul>
          <p class="bubble stain">Starting your next session now.</p>
          <p class="bubble you">Let's go!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Safety ─────────────────────────────────────────────────────────── -->
  <section class="section" data-loc="safety">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">Account safety</p>
        <h2>Your account, <em>treated like his own.</em></h2>
        <p>Boosting is against Riot's rules, so nobody can honestly promise zero risk. This is how Stain keeps it as low as possible — on every order.</p>
      </div>
      <ul class="safety">
        <li class="reveal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A9.7 9.7 0 0 1 12 5c5 0 9 4.5 10 7a12 12 0 0 1-3.2 4.3M6.2 6.2C3.9 7.6 2.5 9.8 2 12c1 2.5 5 7 10 7 1.7 0 3.3-.5 4.6-1.3"/></svg><h3>Invisible</h3><p>Offline mode is on before he logs in. Friends and guild see nothing.</p></li>
        <li class="reveal" style="--d:.06s"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><h3>A VPN matched to you</h3><p>He connects from your country, so your account never “travels”.</p></li>
        <li class="reveal" style="--d:.12s"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg><h3>Your Flash key</h3><p>D or F — he plays on yours. Nothing feels different when you're back.</p></li>
        <li class="reveal" style="--d:.18s"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8 13V5a1.5 1.5 0 0 1 3 0v6M11 11V4a1.5 1.5 0 0 1 3 0v7M14 11V5.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-.5A6.5 6.5 0 0 1 4 15.6L2.6 12a1.5 1.5 0 0 1 2.6-1.4L8 14"/></svg><h3>100% hand-played</h3><p>No bots, no scripts, no third-party software. Ever.</p></li>
      </ul>
      <p class="record reveal"><span class="num">{STATS.bans}</span> bans in <span class="num">{STATS.ordersCompleted}+</span> orders · <a href="/blog/elo-boosting-safe">How detection works</a></p>
    </div>
  </section>

  <!-- ── About ──────────────────────────────────────────────────────────── -->
  <section class="section" id="about" data-loc="about">
    <div class="wrap about">
      <div class="player card reveal">
        <picture>
          <source srcset="/img/stain-160.avif 1x, /img/stain-320.avif 2x" type="image/avif" />
          <img src="/img/stain-160.webp" srcset="/img/stain-320.webp 2x" width="120" height="120" alt="Stain, the booster behind StainBoost" loading="lazy" decoding="async" />
        </picture>
        <p class="p-name">Stain</p>
        <p class="p-title">Challenger · #1 Master Yi · ME</p>
        <dl class="p-stats">
          <div><dt>Rank</dt><dd>{PROOF.peak.tier}</dd></div>
          <div><dt>Yi mastery</dt><dd>{STATS.masteryPoints}</dd></div>
          <div><dt>Orders</dt><dd>{STATS.ordersCompleted}+</dd></div>
        </dl>
        <ul class="accounts">
          {ACCOUNTS.map((a) => (
            <li><a href={a.opgg} target="_blank" rel="noopener" data-track="proof_click" data-track-location="about"><span class="srv">{a.server}</span><span class="rid">{a.riotId}</span><span class="go">OP.GG ↗</span></a></li>
          ))}
        </ul>
        <p class="checked">Rank data from OP.GG, {PROOF.checkedOn}.</p>
      </div>
      <div class="story reveal" style="--d:.08s">
        <p class="eyebrow">The booster</p>
        <h2>Meet the player <em>on your account.</em></h2>
        <p>Stain has played League <strong>since {STATS.playingSince}</strong> and has been on the Middle East server <strong>since it opened in {STATS.meServerSince}</strong>. He's a <strong>Challenger</strong> Master Yi player: a Yi obsession turned into the <strong>#1 Master Yi spot on ME</strong> and over <strong>5 million mastery points</strong> on the champion across his accounts.</p>
        <p>After helping friends climb, StainBoost was born — and it stays one person. <strong>No outsourcing, no third-party boosters, no bots.</strong> When you order, Stain himself plays your games.</p>
        <p>{STATS.ordersCompleted}+ completed orders later, the safety record is still clean: <strong>{STATS.bans} bans</strong>. Check his accounts yourself — they're public.</p>
      </div>
    </div>
  </section>

  <!-- ── Reviews ────────────────────────────────────────────────────────── -->
  <section class="section" data-loc="reviews">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">Verified reviews</p>
        <h2>They doubted. <em>Then they ranked.</em></h2>
        <p>Only buyers with a completed order can post a review — from their own order page.</p>
      </div>
      <div class="grid-3">
        {reviews.slice(0, 3).map((r, i) => <ReviewCard {...r} delay={i * 0.08} />)}
      </div>
      <div class="row row-center reviews-cta">
        <a class="btn btn-ghost" href="/reviews">Read all verified reviews</a>
        <span class="muted">Ordered before? Leave yours from your <a href="/dashboard">dashboard</a>.</span>
      </div>
    </div>
  </section>

  <!-- ── Deal ───────────────────────────────────────────────────────────── -->
  <section class="section-tight" data-loc="deal">
    <div class="wrap">
      <div class="deal reveal">
        <div>
          <p class="eyebrow gold">Net wins</p>
          <p class="deal-title">Pay for 5, <em>get 6.</em></p>
          <p class="deal-sub">Every 5 wins you pay for, Stain plays one more — free. Pay for 10, get 12. Pay for 20, get 24.</p>
        </div>
        <a class="btn btn-gold btn-lg" href="/pricing?mode=wins" data-track="cta_click" data-track-location="deal">Buy net wins <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- ── Questions ──────────────────────────────────────────────────────── -->
  <section class="section" data-loc="faq_home">
    <div class="wrap fears">
      <div class="reveal">
        <div class="section-head">
          <p class="eyebrow">Before you order</p>
          <h2>The questions <em>everyone asks.</em></h2>
          <p>Straight answers. Anything else, ask Stain on <a href={DISCORD.invite} target="_blank" rel="noopener">Discord</a>.</p>
        </div>
        <Guarantees />
      </div>
      <FaqList items={TOP_FAQ} loc="faq_home" />
    </div>
  </section>

  <!-- ── Guides ─────────────────────────────────────────────────────────── -->
  <section class="section" data-loc="blog_teaser">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">Learn to climb</p>
        <h2>Free guides from <em>the #1 Yi on ME.</em></h2>
      </div>
      <div class="grid-3">
        {teasers.map((p, i) => (
          <a class="post card card-glow reveal" style={`--d:${i * 0.08}s`} href={`/blog/${p.id}`}>
            <span class="post-cat">{p.data.category}</span>
            <span class="post-title">{p.data.h1}</span>
            <span class="post-ex">{p.data.excerpt}</span>
            <span class="post-more">Read · {p.data.readTime}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing scene ──────────────────────────────────────────────────── -->
  <section class="finale" data-loc="final_cta">
    <picture aria-hidden="true">
      <source srcset="/img/scene/scene-soft.avif" type="image/avif" />
      <img class="finale-bg" src="/img/scene/scene-soft.webp" width="640" height="378" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="wrap finale-in reveal">
      <StatusChip />
      <h2>Ready when <em>you are.</em></h2>
      <p>Pick your rank, see the price, and Stain takes it from there. Full refund if the boost hasn't started.</p>
      <div class="row row-center">
        <a class="btn btn-primary btn-lg" href="/pricing" data-track="cta_click" data-track-location="final_cta">See my price <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={arrow} /></a>
        <a class="btn btn-ghost btn-lg" href={DISCORD.invite} target="_blank" rel="noopener">Ask on Discord</a>
      </div>
    </div>
  </section>

  <StickyOrderBar slot="after" watch="[data-scene], [data-climb] [data-cta]" label="Silver II → Gold IV" price={heroPrice} href="/pricing?mode=rank&from=2-2&to=3-0&queue=solo" />
</Base>

<script>
  import '../scripts/scene.js';
</script>
