---
// One template for every blog post (src/content/blog/<slug>.md).
// Posts migrated from the old site carry their own styles/extras in src/blog-assets/.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, STATS, ACCOUNTS, PROOF } from '../../data/site.js';
import { breadcrumbs } from '../../data/schema.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const css = import.meta.glob('../../blog-assets/*.css', { query: '?raw', import: 'default', eager: true });
const heroes = import.meta.glob('../../blog-assets/*.hero.html', { query: '?raw', import: 'default', eager: true });
const scripts = import.meta.glob('../../blog-assets/*.js', { query: '?raw', import: 'default', eager: true });
const legacyCss = css[`../../blog-assets/${post.id}.css`] || '';
const hero = heroes[`../../blog-assets/${post.id}.hero.html`] || '';
const pageJs = scripts[`../../blog-assets/${post.id}.js`] || '';
// A migrated hero with a background image is the largest paint: fetch it first.
const heroImage = hero && legacyCss.match(/\.champ-hero-bg\{[^}]*url\('([^']+)'\)/)?.[1];

// Table of contents: Markdown headings, or <h2 id> in migrated HTML posts.
let toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text }));
if (!toc.length && post.body) {
  const decode = (s) => s.replace(/&amp;/g, '&').replace(/&#39;|&#x27;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
  toc = [...post.body.matchAll(/<h2[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((m) => ({ id: m[1], text: decode(m[2].replace(/<[^>]+>/g, '').trim()) }));
}
const related = posts.filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.category === d.category) - (a.data.category === d.category) || a.data.order - b.data.order)
  .slice(0, 3);
const iso = (x) => x.toISOString().slice(0, 10);
const fmt = (x) => x.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const url = `${SITE.url}/blog/${post.id}`;
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.h1, description: d.description,
  datePublished: iso(d.published), dateModified: iso(d.updated ?? d.published), mainEntityOfPage: url,
  image: SITE.url + '/og-image.png',
  author: { '@type': 'Person', name: 'Stain', description: `${STATS.rank} · #1 Master Yi on the Middle East server`, url: SITE.url + '/#about' },
  publisher: { '@type': 'Organization', name: 'StainBoost', logo: { '@type': 'ImageObject', url: SITE.url + '/icon-512.png' } },
};
---
<Base
  title={d.title}
  description={d.description}
  path={`/blog/${post.id}`}
  ogType="article"
  active="/blog"
  schema={[article, breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: d.h1, path: `/blog/${post.id}` }])]}
>
  <Fragment slot="head">
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    {legacyCss && <style is:inline set:html={legacyCss} />}
  </Fragment>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="post-scope" data-loc="article">
    {hero && <div class="legacy-hero" set:html={hero} />}
    <div class="wrap-narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog">Blog</a> / <span>{d.category}</span></nav>
      <header class="post-head">
        <p class="eyebrow">{d.category}</p>
        <h1>{d.h1}</h1>
        <div class="byline">
          <picture><source srcset="/img/stain-160.avif" type="image/avif" /><img src="/img/stain-160.webp" width="44" height="44" alt="" /></picture>
          <div><p class="by-name">Stain</p><p class="by-title">{STATS.rank} · #1 Master Yi · ME</p></div>
          <p class="by-meta">{d.readTime} · Updated {fmt(d.updated ?? d.published)}</p>
        </div>
      </header>

      {toc.length > 2 && (
        <nav class="toc card" aria-label="In this article">
          <p class="label">In this article</p>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      )}

      <div class="article-content prose">
        <Content />
      </div>

      <aside class="author card" aria-label="About the author">
        <picture><source srcset="/img/stain-160.avif 1x, /img/stain-320.avif 2x" type="image/avif" /><img src="/img/stain-160.webp" width="72" height="72" alt="Stain" loading="lazy" /></picture>
        <div>
          <p class="label">Written by</p>
          <p class="a-name">Stain</p>
          <p class="muted">{STATS.rank} Master Yi, #1 Master Yi on the Middle East server, {STATS.masteryPoints} Yi mastery across his accounts and {STATS.ordersCompleted}+ boosting orders. Every StainBoost order is played by him.</p>
          <p class="links">{ACCOUNTS.map((a) => <a href={a.opgg} target="_blank" rel="noopener">{a.riotId} ({a.server}) ↗</a>)}</p>
        </div>
      </aside>

      <div class="card quote-cta">
        <div><h2>Want to skip the grind?</h2><p class="muted">See your exact price in seconds. Full refund if the boost hasn't started.</p></div>
        <a class="btn btn-primary" href="/pricing" data-track="cta_click" data-track-location="article_end">Get my price</a>
      </div>

      <section class="related" aria-labelledby="rel">
        <h2 id="rel">Keep reading</h2>
        <div class="rel-grid">
          {related.map((p) => (
            <a class="card card-glow rel" href={`/blog/${p.id}`}>
              <span class="post-emoji" aria-hidden="true">{p.data.emoji}</span>
              <span class="rel-cat">{p.data.category}</span>
              <span class="rel-title">{p.data.h1}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
  {pageJs && <script is:inline set:html={pageJs} />}
</Base>

<script>
  const bar = document.querySelector('[data-progress]');
  if (bar) {
    const upd = () => { const h = document.documentElement; const max = h.scrollHeight - h.clientHeight; bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`; };
    addEventListener('scroll', upd, { passive: true }); // no call on load: it would force a layout before first paint
  }
</script>

<style>
  .progress { position: fixed; inset-inline: 0; inset-block-start: 0; height: 3px; z-index: 80; pointer-events: none; }
  .progress span { display: block; height: 100%; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, var(--purple), var(--cyan)); }
  .post-scope { --bg-card: var(--card); padding-block: 22px 40px; }
  .post-scope :global(.champ-hero) { margin-top: 0 !important; }
  .crumbs { font-size: .85rem; color: var(--muted); margin-block-end: 18px; }
  .crumbs a { color: var(--muted); }
  .post-head { display: grid; gap: 12px; margin-block-end: 22px; }
  .post-head h1 { font-size: clamp(1.7rem, 3vw + .6rem, 2.6rem); line-height: 1.15; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; border: 2px solid rgba(196, 181, 253, .5); }
  .by-name { font-family: var(--font-ui); font-weight: 700; color: #fff; }
  .by-title { font-family: var(--font-ui); font-weight: 700; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .by-meta { margin-inline-start: auto; font-size: .88rem; color: var(--muted); }
  .toc { margin-block-end: 26px; }
  .toc ol { margin-block-start: 8px; padding-inline-start: 1.2rem; display: grid; gap: 4px; }
  .toc a { color: var(--purple-light); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  /* Default prose for new Markdown posts (migrated posts bring their own styles) */
  .prose { font-size: 1.02rem; line-height: 1.8; color: rgba(255, 255, 255, .78); }
  .prose :global(h2) { font-size: clamp(1.25rem, 1vw + 1rem, 1.6rem); margin-block: 2.2rem .8rem; color: #fff; scroll-margin-top: 90px; }
  .prose :global(h3) { font-family: var(--font-ui); font-size: 1.25rem; margin-block: 1.6rem .5rem; color: #fff; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-block-end: 1rem; }
  .prose :global(li) { margin-block-end: .35rem; }
  .prose :global(strong) { color: #fff; }
  .prose :global(a) { color: var(--purple-light); }
  .prose :global(img) { border-radius: 14px; }
  .author { display: flex; gap: 16px; align-items: flex-start; margin-block: 34px 18px; }
  .author picture, .byline picture { flex: none; }
  .author img { width: 72px; height: 72px; border-radius: 50%; border: 2px solid rgba(196, 181, 253, .5); flex: none; }
  .a-name { font-family: var(--font-display); font-weight: 900; color: #fff; font-size: 1.1rem; margin-block: 2px 4px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-block-start: 8px; font-size: .9rem; }
  .quote-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; border-color: rgba(139, 92, 246, .35); background: linear-gradient(135deg, rgba(124, 58, 237, .16), var(--card)); }
  .quote-cta h2 { font-size: 1.3rem; margin-block-end: 4px; }
  .related { margin-block-start: 34px; }
  .related h2 { font-size: 1.2rem; margin-block-end: 14px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .rel { display: grid; gap: 6px; text-decoration: none; color: inherit; align-content: start; }
  .rel-cat { font-family: var(--font-ui); font-weight: 700; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--cyan); }
  .rel-title { font-family: var(--font-ui); font-weight: 700; color: #fff; line-height: 1.3; }
  .post-emoji { font-size: 1.5rem; }
  @media (max-width: 720px) { .rel-grid { grid-template-columns: 1fr; } .by-meta { margin-inline-start: 0; width: 100%; } }
  .article-content { overflow-wrap: break-word; }
  /* comparison tables from the old posts: tighter cells so they fit a 360px phone */
  @media (max-width: 480px) { .post-scope :global(table th), .post-scope :global(table td) { padding-inline: .55rem; } }
</style>
