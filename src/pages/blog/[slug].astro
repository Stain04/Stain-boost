---
// One template for every blog post (src/content/blog/<slug>.md).
// Posts migrated from the old site carry their own styles/extras in src/blog-assets/.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, STATS, ACCOUNTS, PROOF } from '../../data/site.js';
import { breadcrumbs } from '../../data/schema.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const css = import.meta.glob('../../blog-assets/*.css', { query: '?raw', import: 'default', eager: true });
const heroes = import.meta.glob('../../blog-assets/*.hero.html', { query: '?raw', import: 'default', eager: true });
const scripts = import.meta.glob('../../blog-assets/*.js', { query: '?raw', import: 'default', eager: true });
// Old posts bring their own CSS written for the old fonts: map them to the current type and soften the weights.
const legacyCss = (css[`../../blog-assets/${post.id}.css`] || '')
  .replaceAll("'Orbitron',sans-serif", 'var(--font-display)')
  .replaceAll("'Rajdhani',sans-serif", 'var(--font-ui)')
  .replaceAll("'Inter',sans-serif", 'var(--font-body)')
  .replace(/font-weight:(600|700|800|900)/g, 'font-weight:500');
const hero = heroes[`../../blog-assets/${post.id}.hero.html`] || '';
const pageJs = scripts[`../../blog-assets/${post.id}.js`] || '';
// A migrated hero with a background image is the largest paint: fetch it first.
const heroImage = hero && legacyCss.match(/\.champ-hero-bg\{[^}]*url\('([^']+)'\)/)?.[1];

// Table of contents: Markdown headings, or <h2 id> in migrated HTML posts.
let toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text }));
if (!toc.length && post.body) {
  const decode = (s) => s.replace(/&amp;/g, '&').replace(/&#39;|&#x27;/g, "'").replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
  toc = [...post.body.matchAll(/<h2[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((m) => ({ id: m[1], text: decode(m[2].replace(/<[^>]+>/g, '').trim()) }));
}
const related = posts.filter((p) => p.id !== post.id)
  .sort((a, b) => (b.data.category === d.category) - (a.data.category === d.category) || a.data.order - b.data.order)
  .slice(0, 3);
const iso = (x) => x.toISOString().slice(0, 10);
const fmt = (x) => x.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const url = `${SITE.url}/blog/${post.id}`;
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.h1, description: d.description,
  datePublished: iso(d.published), dateModified: iso(d.updated ?? d.published), mainEntityOfPage: url,
  image: SITE.url + '/og-image.jpg',
  author: { '@type': 'Person', name: 'Stain', description: `${STATS.rank} · #1 Master Yi on the Middle East server`, url: SITE.url + '/#about' },
  publisher: { '@type': 'Organization', name: 'StainBoost', logo: { '@type': 'ImageObject', url: SITE.url + '/icon-512.png' } },
};
---
<Base
  title={d.title}
  description={d.description}
  path={`/blog/${post.id}`}
  ogType="article"
  active="/blog"
  schema={[article, breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: d.h1, path: `/blog/${post.id}` }])]}
>
  <Fragment slot="head">
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    {legacyCss && <style is:inline set:html={legacyCss} />}
  </Fragment>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="post-scope" data-loc="article">
    {hero && <div class="legacy-hero" set:html={hero} />}
    <div class="wrap-narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog">Blog</a> / <span>{d.category}</span></nav>
      <header class="post-head">
        <p class="eyebrow">{d.category}</p>
        <h1>{d.h1}</h1>
        <div class="byline">
          <picture><source srcset="/img/stain-160.avif" type="image/avif" /><img src="/img/stain-160.webp" width="44" height="44" alt="" /></picture>
          <div><p class="by-name">Stain</p><p class="by-title">{STATS.rank} · #1 Master Yi · ME</p></div>
          <p class="by-meta">{d.readTime} · Updated {fmt(d.updated ?? d.published)}</p>
        </div>
      </header>

      {toc.length > 2 && (
        <nav class="toc card" aria-label="In this article">
          <p class="label">In this article</p>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      )}

      <div class:list={['article-content', 'prose', { native: !legacyCss }]}>
        <Content />
      </div>

      <aside class="author card" aria-label="About the author">
        <picture><source srcset="/img/stain-160.avif 1x, /img/stain-320.avif 2x" type="image/avif" /><img src="/img/stain-160.webp" width="72" height="72" alt="Stain" loading="lazy" /></picture>
        <div>
          <p class="label">Written by</p>
          <p class="a-name">Stain</p>
          <p class="muted">{STATS.rank} Master Yi, #1 Master Yi on the Middle East server, {STATS.masteryPoints} Yi mastery across his accounts and {STATS.ordersCompleted}+ boosting orders. Every StainBoost order is played by him.</p>
          <p class="links">{ACCOUNTS.map((a) => <a href={a.opgg} target="_blank" rel="noopener">{a.riotId} ({a.server}) ↗</a>)}</p>
        </div>
      </aside>

      <div class="card quote-cta">
        <div><h2>Want to skip the grind?</h2><p class="muted">See your exact price in seconds. Full refund if the boost hasn't started.</p></div>
        <a class="btn btn-primary" href="/pricing" data-track="cta_click" data-track-location="article_end">Get my price</a>
      </div>

      <section class="related" aria-labelledby="rel">
        <h2 id="rel">Keep reading</h2>
        <div class="rel-grid">
          {related.map((p) => (
            <a class="card card-glow rel" href={`/blog/${p.id}`}>
              <span class="post-emoji" aria-hidden="true">{p.data.emoji}</span>
              <span class="rel-cat">{p.data.category}</span>
              <span class="rel-title">{p.data.h1}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
  {pageJs && <script is:inline set:html={pageJs} />}
</Base>

<script>
  const bar = document.querySelector('[data-progress]');
  if (bar) {
    const upd = () => { const h = document.documentElement; const max = h.scrollHeight - h.clientHeight; bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`; };
    addEventListener('scroll', upd, { passive: true }); // no call on load: it would force a layout before first paint
  }
</script>

<style>
  .progress { position: fixed; inset-inline: 0; inset-block-start: 0; height: 2px; z-index: 80; pointer-events: none; }
  .progress span { display: block; height: 100%; transform-origin: left; transform: scaleX(0); background: var(--lav); }
  .post-scope { --bg-card: var(--card); padding-block: 28px 48px; }
  .post-scope :global(.champ-hero) { margin-top: 0 !important; }
  .crumbs { font-size: .84rem; color: var(--muted); margin-block-end: 22px; }
  .crumbs a { color: var(--muted); }
  .post-head { display: grid; gap: 16px; margin-block-end: 30px; }
  .post-head h1 { font-size: clamp(2.4rem, 3vw + 1.2rem, 3.6rem); line-height: 1.05; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(196, 181, 253, .45); }
  .by-name { color: var(--text-strong); font-weight: 400; }
  .by-title { font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--lav); }
  .by-meta { margin-inline-start: auto; font-size: .88rem; color: var(--muted); }
  .toc { margin-block-end: 34px; }
  .toc ol { margin-block-start: 10px; padding-inline-start: 1.3rem; display: grid; gap: 6px; }
  .toc a { color: var(--text); text-decoration: none; }
  .toc a:hover { color: var(--lav-hi); }
  /* Default prose for new Markdown posts */
  .prose { font-size: 1.06rem; line-height: 1.8; color: var(--text); }
  .prose :global(h2) { font-size: clamp(1.9rem, 1vw + 1.5rem, 2.4rem); margin-block: 2.6rem .9rem; color: var(--text-strong); scroll-margin-top: 100px; }
  .prose :global(h3) { font-size: 1.5rem; margin-block: 1.8rem .6rem; color: var(--text-strong); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-block-end: 1.1rem; }
  .prose :global(li) { margin-block-end: .4rem; }
  .prose :global(strong) { color: var(--text-strong); font-weight: 500; }
  .prose :global(a) { color: var(--lav); }
  .prose :global(img) { border-radius: 16px; }
  .prose :global(code) { font-family: ui-monospace, Consolas, monospace; font-size: .9em; padding: .1em .45em; border-radius: 6px; background: rgba(246, 242, 255, .07); color: var(--text-strong); }
  /* building blocks for new posts (posts without their own legacy CSS) */
  .native :global(.tip-card) { margin-block: 1.8rem; padding: 1.4rem 1.6rem; border-radius: 20px; background: linear-gradient(180deg, rgba(255, 255, 255, .045), rgba(255, 255, 255, .015)); box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .1); }
  .native :global(.tip-number) { font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--lav); margin-block-end: .35rem; }
  .native :global(.tip-card h3) { margin-block: 0 .5rem; }
  .native :global(:is(.tip-card, .mistake-card, .callout) p) { margin-block-end: .6rem; }
  .native :global(:is(.tip-card, .mistake-card, .callout) p:last-child) { margin-block-end: 0; }
  .native :global(.mistake-card) { margin-block: 1rem; padding: 1rem 1.3rem; border-radius: 16px; background: rgba(252, 165, 165, .04); box-shadow: inset 0 0 0 1px rgba(252, 165, 165, .2); }
  .native :global(.mistake-card strong) { color: #fecaca; }
  .native :global(.callout) { margin-block: 1.6rem; padding: 1.2rem 1.4rem; border-radius: 18px; background: rgba(196, 181, 253, .05); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .18); }
  .native :global(.cta-box) { margin-block-start: 3rem; padding: clamp(28px, 4vw, 44px); border-radius: var(--r-lg); text-align: center; background: radial-gradient(120% 90% at 50% 0%, rgba(196, 181, 253, .1), transparent 60%), linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .018)); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .22); }
  .native :global(.cta-box h3) { font-weight: 400; font-size: 2rem; margin-block: 0 .6rem; }
  .native :global(.cta-box p) { color: var(--muted); margin-block-end: 1.4rem; }
  .native :global(.cta-box .btn-primary) { display: inline-flex; align-items: center; gap: .55rem; padding: 14px 28px; border-radius: 999px; background: var(--lav); color: var(--lav-ink); text-decoration: none; border: 0; font-family: var(--font-ui); font-size: 1rem; letter-spacing: .02em; box-shadow: 0 16px 34px -18px rgba(0, 0, 0, .75); }
  .native :global(.cta-box .btn-primary svg) { width: 16px; height: 16px; flex: none; }
  .native :global(.table-wrap) { overflow-x: auto; margin-block: 1.4rem; border-radius: 16px; box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .1); }
  .native :global(.table-wrap table) { width: 100%; border-collapse: collapse; font-size: .96rem; font-variant-numeric: tabular-nums; }
  .native :global(:is(.table-wrap th, .table-wrap td)) { text-align: start; padding: .75rem 1rem; white-space: nowrap; }
  .native :global(.table-wrap td) { border-top: 1px solid rgba(246, 242, 255, .07); }
  @media (max-width: 480px) { .native :global(:is(.table-wrap th, .table-wrap td)) { padding: .65rem .7rem; } }
  /* the old posts' shared elements, in the current style (doubled class: beats their own CSS) */
  .post-scope.post-scope :global(.article-content h2) { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 1vw + 1.5rem, 2.4rem); line-height: 1.12; letter-spacing: -.005em; text-transform: none; background: none; -webkit-text-fill-color: currentColor; color: var(--text-strong); margin-block: 2.6rem .9rem; scroll-margin-top: 100px; }
  .post-scope.post-scope :global(.article-content h3) { font-family: var(--font-display); font-weight: 500; font-size: 1.5rem; letter-spacing: 0; text-transform: none; color: var(--text-strong); }
  .post-scope.post-scope :global(.article-content p), .post-scope.post-scope :global(.article-content li) { font-size: 1.04rem; color: var(--text); line-height: 1.8; }
  .post-scope.post-scope :global(.article-content strong) { color: var(--text-strong); font-weight: 500; }
  .post-scope.post-scope :global(.article-content a) { color: var(--lav); border-bottom-color: rgba(196, 181, 253, .35); }
  .post-scope.post-scope :global(.article-content a:hover) { color: var(--lav-hi); border-color: var(--lav-hi); }
  .post-scope.post-scope :global(:is(.callout, .callout-green, .callout-gold, .tip-box, .warning-box)) { border: 0; border-radius: 18px; background: rgba(196, 181, 253, .05); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .18); }
  .post-scope.post-scope :global(:is(.callout, .callout-green, .callout-gold, .tip-box, .warning-box) p) { color: var(--text); }
  .post-scope.post-scope :global(table th) { background: rgba(255, 255, 255, .03); font-weight: 400; font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid rgba(246, 242, 255, .12); }
  .post-scope.post-scope :global(table td) { color: var(--text); border-bottom-color: rgba(246, 242, 255, .07); }
  .post-scope.post-scope :global(.cta-box) { border: 0; border-radius: var(--r-lg); background: linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .018)); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .2); }
  .post-scope.post-scope :global(.cta-box h3) { font-family: var(--font-display); font-weight: 400; font-size: 2rem; }
  .post-scope.post-scope :global(.cta-box p) { color: var(--muted); }
  /* button text must beat the article link colour (same specificity as ".article-content a:hover", declared later) */
  .post-scope.post-scope :global(.article-content a.btn-primary) { font-family: var(--font-ui); font-weight: 400; font-size: 1rem; letter-spacing: .02em; text-transform: none; padding: 14px 28px; border: 0; border-radius: 999px; background: var(--lav); color: var(--lav-ink); box-shadow: 0 16px 34px -18px rgba(0, 0, 0, .75); }
  .post-scope.post-scope :global(.article-divider) { background: rgba(246, 242, 255, .08); }
  .author { display: flex; gap: 18px; align-items: flex-start; margin-block: 44px 18px; }
  .author picture, .byline picture { flex: none; }
  .author img { width: 72px; height: 72px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(196, 181, 253, .45); flex: none; }
  .a-name { font-family: var(--font-display); font-weight: 400; color: var(--text-strong); font-size: 1.7rem; line-height: 1.1; margin-block: 4px 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 14px; margin-block-start: 10px; font-size: .92rem; }
  .quote-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .22); }
  .quote-cta h2 { font-size: 2rem; margin-block-end: 6px; }
  .related { margin-block-start: 48px; }
  .related h2 { font-size: 2rem; margin-block-end: 18px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .rel { display: grid; gap: 8px; text-decoration: none; color: inherit; align-content: start; }
  .rel-cat { font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--lav); }
  .rel-title { font-family: var(--font-display); font-size: 1.35rem; color: var(--text-strong); line-height: 1.2; }
  .post-emoji { display: none; }
  @media (max-width: 720px) { .rel-grid { grid-template-columns: 1fr; } .by-meta { margin-inline-start: 0; width: 100%; } }
  .article-content { overflow-wrap: break-word; }
  /* comparison tables from the old posts: tighter cells so they fit a 360px phone */
  @media (max-width: 480px) { .post-scope :global(table th), .post-scope :global(table td) { padding-inline: .55rem; } }
</style>
