---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getVerifiedReviews, ratingSummary } from '../data/reviews.js';
import { STATS } from '../data/site.js';
import { boostProduct, breadcrumbs } from '../data/schema.js';

const reviews = await getVerifiedReviews();
const r = ratingSummary(reviews);
---
<Base
  title={`Verified Reviews – StainBoost ELO Boosting Middle East | ${STATS.ordersCompleted}+ Orders`}
  description={`Verified reviews from real StainBoost buyers — every review is posted from a completed order. ${STATS.ordersCompleted}+ orders on the Middle East server, ${STATS.bans} bans.`}
  path="/reviews"
  active="/reviews"
  schema={[boostProduct(reviews), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews' }])]}
>
  <section class="section-tight head" data-loc="reviews_head">
    <div class="wrap">
      <p class="eyebrow">Verified reviews</p>
      <h1>Real buyers. <span class="grad">Real results.</span></h1>
      <p class="lead">Only a customer with a completed order can post a review — from their own order page, once per order. Nothing here is written by us.</p>
    </div>
  </section>

  <section data-loc="reviews_list">
    <div class="wrap">
      <div class="summary card" aria-label="Rating summary">
        <div class="big">
          <span class="avg num" data-avg>{r.avg.toFixed(1)}</span>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="count" data-count>{r.count} verified review{r.count !== 1 ? 's' : ''}</span>
        </div>
        <ul class="bars" data-bars>
          {[5, 4, 3, 2, 1].map((s) => (
            <li><span>{s}★</span><span class="track"><span class="fill" style={`width:${r.count ? (r.counts[s] / r.count) * 100 : 0}%`}></span></span><span class="n">{r.counts[s]}</span></li>
          ))}
        </ul>
        <p class="note">From {STATS.ordersCompleted}+ completed orders. Most buyers never leave a review — every one here comes from a real, finished order.</p>
      </div>

      <div class="grid-3 list" data-list>
        {reviews.map((rv, i) => <ReviewCard {...rv} delay={(i % 3) * 0.05} />)}
        <div class="placeholder card">
          <p class="ph-title">Your review could be next</p>
          <p class="muted">Ordered from Stain? When your order is completed, a <strong>Leave a review</strong> button appears on your order page.</p>
          <a class="btn btn-ghost btn-sm" href="/dashboard">Open my orders</a>
        </div>
      </div>

      <div class="cta card">
        <div>
          <h2>Ready to be next?</h2>
          <p class="muted">Pick your rank, see the price, and Stain plays every game himself.</p>
        </div>
        <a class="btn btn-primary btn-lg" href="/pricing" data-track="cta_click" data-track-location="reviews">Get my price</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Refresh from the live list so a review posted after the last deploy shows up immediately.
  import { ratingSummary } from '../data/reviews.js';
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  fetch('/api/reviews').then((r) => (r.ok ? r.json() : null)).then((list) => {
    if (!Array.isArray(list)) return;
    const reviews = list.filter((x) => x && x.name && x.text).map((x) => ({ ...x, stars: Math.max(1, Math.min(5, parseInt(x.stars, 10) || 5)) }));
    const shown = document.querySelectorAll('[data-list] .review').length;
    if (reviews.length <= shown) return;
    const box = document.querySelector('[data-list]');
    const ph = box.querySelector('.placeholder');
    box.querySelectorAll('.review').forEach((n) => n.remove());
    reviews.forEach((rv) => {
      const initials = rv.name.trim().split(/[\s_.-]+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase();
      const el = document.createElement('figure');
      el.className = 'review card card-glow';
      el.innerHTML = `<div class="top"><span class="stars" role="img" aria-label="${rv.stars} out of 5 stars">${'★'.repeat(rv.stars)}<span class="dim">${'★'.repeat(5 - rv.stars)}</span></span><span class="date">${esc(rv.date || '')}</span></div>${rv.rank ? `<p class="rank">${esc(rv.rank)}</p>` : ''}<blockquote>${esc(rv.text)}</blockquote><figcaption><span class="ava" aria-hidden="true">${esc(initials)}</span><span><span class="name">${esc(rv.name)}</span><span class="verified">✓ Verified order</span></span></figcaption>`;
      box.insertBefore(el, ph);
    });
    const s = ratingSummary(reviews);
    document.querySelector('[data-avg]').textContent = s.avg.toFixed(1);
    document.querySelector('[data-count]').textContent = `${s.count} verified review${s.count !== 1 ? 's' : ''}`;
    document.querySelectorAll('[data-bars] li').forEach((li, i) => {
      const star = 5 - i;
      li.querySelector('.fill').style.width = `${(s.counts[star] / s.count) * 100}%`;
      li.querySelector('.n').textContent = s.counts[star];
    });
  }).catch(() => {});
</script>

<style>
  .head h1 { font-size: clamp(2.8rem, 4vw + 1rem, 4.6rem); margin-block: 14px 16px; }
  .summary { display: grid; grid-template-columns: auto 1fr; gap: clamp(22px, 4vw, 56px); align-items: center; margin-block-end: 24px; }
  .big { display: grid; justify-items: center; gap: 6px; padding-inline: 10px; }
  .avg { font-size: 4.2rem; line-height: 1; color: var(--text-strong); }
  .big .stars { color: var(--gold); letter-spacing: 3px; font-size: 1rem; }
  .count { color: var(--muted); letter-spacing: .04em; font-size: .92rem; }
  .bars { list-style: none; padding: 0; display: grid; gap: 10px; }
  .bars li { display: grid; grid-template-columns: 34px 1fr 28px; gap: 12px; align-items: center; color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; }
  .track { height: 3px; border-radius: 3px; background: rgba(246, 242, 255, .08); overflow: hidden; }
  .fill { display: block; height: 100%; border-radius: inherit; background: var(--gold); }
  .n { text-align: end; }
  .note { grid-column: 1 / -1; font-size: .9rem; color: var(--muted); box-shadow: inset 0 1px 0 rgba(246, 242, 255, .08); padding-block-start: 14px; }
  .list { margin-block-end: 32px; }
  .placeholder { display: grid; gap: 12px; align-content: center; justify-items: start; background: transparent; box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .3); }
  .ph-title { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.15; color: var(--text-strong); }
  .placeholder strong { color: var(--text-strong); font-weight: 400; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .22); }
  .cta h2 { font-size: clamp(2rem, 2vw + 1.2rem, 2.8rem); margin-block-end: 6px; }
  /* cards (and the ones the live refresh injects) match ReviewCard */
  .list :global(.review) { display: flex; flex-direction: column; gap: 16px; }
  .list :global(.review .top) { display: flex; justify-content: space-between; align-items: center; }
  .list :global(.review .stars) { color: var(--gold); letter-spacing: 3px; font-size: .9rem; }
  .list :global(.review .dim) { color: rgba(246, 242, 255, .15); }
  .list :global(.review .date) { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .list :global(.review .rank) { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--lav); }
  .list :global(.review blockquote) { flex: 1; font-family: var(--font-display); font-style: italic; font-size: 1.42rem; line-height: 1.35; color: var(--text-strong); }
  .list :global(.review figcaption) { display: flex; align-items: center; gap: 12px; padding-block-start: 14px; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .07); }
  .list :global(.review .ava) { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: .8rem; color: var(--lav-hi); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .4); }
  .list :global(.review .name) { display: block; color: var(--text-strong); }
  .list :global(.review .verified) { display: block; font-size: .78rem; color: var(--success); }
  @media (max-width: 640px) { .summary { grid-template-columns: 1fr; } }
</style>
