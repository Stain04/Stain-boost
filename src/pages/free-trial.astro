---
// Time-limited free trial (settings in src/data/promo.js). Temporary page: noindex, not in the sitemap.
import Base from '../layouts/Base.astro';
import { FREE_TRIAL, TRIAL_ENDS_MS } from '../data/promo.js';
import { DISCORD, STATS, REGIONS } from '../data/site.js';

const trialOn = Date.now() < TRIAL_ENDS_MS;
const g = FREE_TRIAL.games;
---
<Base
  title={`Free trial: your first ${g} games free – StainBoost`}
  description={`New to StainBoost? Stain plays your first ${g} ranked games on ME, EUW or EUNE for free — no payment, no card. Limited time.`}
  path="/free-trial"
  noindex
  promo={false}
>
  <section class="section-tight" data-loc="free_trial">
    <div class="wrap ft">
      <div class="ft-head">
        <p class="eyebrow">Free trial · 2 days only</p>
        <h1>Your first {g} games <span class="grad">are on Stain.</span></h1>
        <p class="lead">Not sure about boosting yet? Stain plays {g} ranked games — on your account or duo with you — <strong>for free</strong>. No payment, no card. See how it works, then decide.</p>
        {trialOn && <p class="ft-count" data-trial><span class="ft-clock" aria-hidden="true">⏳</span><span data-trial-countdown data-end={TRIAL_ENDS_MS}>Ends Fri 2 Oct</span><small>Offer ends {FREE_TRIAL.endsLabel}</small></p>}
      </div>

      <div class="ft-copy">
        <ol class="ft-steps">
          <li><b>Sign in</b> with Discord — 10 seconds. It's how you'll follow your games.</li>
          <li><b>Tell Stain your Riot ID</b> and Discord, then press Claim.</li>
          <li><b>Stain plays your {g} games</b> — watch every result live on your tracker. Liked it? Get your price and keep climbing.</li>
        </ol>

        <div class="ft-rules">
          <p class="label">The small print</p>
          <ul>
            <li>New customers only — one free trial per account, Riot ID and Discord.</li>
            <li>{g} ranked games on your server: ME, EUW or EUNE. It's a trial of the service, so wins aren't guaranteed.</li>
            <li>Same safety as every order: offline mode, a VPN matched to your country, your Flash key. {STATS.bans} bans in {STATS.ordersCompleted}+ orders.</li>
            <li>Nothing to cancel, nothing charged. After the {g} games you order only if you want to.</li>
            <li>Claims close {FREE_TRIAL.endsLabel}.</li>
          </ul>
        </div>
      </div>

      <div class="ft-side">
        {trialOn && (
          <form class="card ft-form" data-form data-trial novalidate>
            <p class="ft-form-title">Claim my {g} free games</p>
            <p class="ft-who muted" data-who>You'll sign in with Discord when you press Claim.</p>
            <div class="field">
              <label for="ftIgn">League Riot ID</label>
              <input id="ftIgn" name="ign" class="input" autocomplete="off" maxlength="60" placeholder="Name#ME1" required />
            </div>
            <div class="field">
              <label for="ftDiscord">Discord username</label>
              <input id="ftDiscord" name="discord" class="input" autocomplete="off" maxlength="80" placeholder="e.g. yourname" required />
              <p class="hint">Stain messages you here to agree on a time.</p>
            </div>
            <div class="field">
              <span class="field-label" id="ftServerL">Server</span>
              <div class="ft-seg" role="radiogroup" aria-labelledby="ftServerL">
                {REGIONS.filter((r) => r.live).map((r) => <label><input type="radio" name="region" value={r.code} checked={r.code === 'me'} /><span>{r.code.toUpperCase()}</span></label>)}
              </div>
            </div>
            <div class="field">
              <span class="field-label" id="ftQueueL">How should Stain play?</span>
              <div class="ft-seg" role="radiogroup" aria-labelledby="ftQueueL">
                <label><input type="radio" name="type" value="solo" checked /><span>Solo<small>On your account</small></span></label>
                <label><input type="radio" name="type" value="duo" /><span>Duo<small>With you</small></span></label>
              </div>
            </div>
            <button class="btn btn-gold btn-block btn-lg" type="submit" data-submit>Claim my {g} free games</button>
            <p class="ft-note">No payment · ME, EUW or EUNE · <a href={`/login?return=${encodeURIComponent('/free-trial?resume=1')}`} data-email-login>sign in with email instead</a></p>
            <p class="err" data-err role="alert" hidden></p>
          </form>
        )}

        <div class="card ft-state" data-state hidden aria-live="polite"></div>

        <div class="card ft-state ft-over" data-trial-over={trialOn ? '' : undefined}>
          <p class="t">This free trial has ended</p>
          <p class="muted">Thanks for the interest! You can still see your exact price in seconds — with a full refund if the boost hasn't started.</p>
          <a class="btn btn-primary" href="/pricing" data-track="cta_click" data-track-location="trial_over">Get my price</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { track } from '../scripts/analytics.js';
  import { DISCORD } from '../data/site.js';
  import { FREE_TRIAL, trialActive } from '../data/promo.js';

  const form = document.querySelector('[data-form]');
  const stateBox = document.querySelector('[data-state]');
  const SAVED = 'sb_trial_form_v1';
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function show(html) {
    stateBox.innerHTML = html;
    stateBox.hidden = false;
    if (form) form.hidden = true;
  }
  const read = () => ({
    ign: form.ign.value.trim(), discord: form.discord.value.trim(),
    type: form.querySelector('input[name="type"]:checked').value,
    region: form.querySelector('input[name="region"]:checked').value,
  });
  const save = () => { try { localStorage.setItem(SAVED, JSON.stringify({ ...read(), ts: Date.now() })); } catch {} };
  function restore() {
    try {
      const s = JSON.parse(localStorage.getItem(SAVED) || 'null');
      if (!s || Date.now() - s.ts > 3 * 3600e3) return false;
      form.ign.value = s.ign || ''; form.discord.value = s.discord || '';
      form.querySelector(`input[name="type"][value="${s.type === 'duo' ? 'duo' : 'solo'}"]`).checked = true;
      if (['me', 'euw', 'eune'].includes(s.region)) form.querySelector(`input[name="region"][value="${s.region}"]`).checked = true;
      return true;
    } catch { return false; }
  }

  const booked = (token, type) => `
    <p class="t">🎉 Your ${FREE_TRIAL.games} free games are booked!</p>
    <p>Order <strong class="tok">${esc(token)}</strong> · free trial${type ? ' · ' + esc(type) : ''}.</p>
    <p class="muted"><b>Next:</b> add <strong>${DISCORD.handle}</strong> on Discord and say hi — Stain agrees a time with you. He usually replies within minutes.</p>
    <div class="row">
      <button type="button" class="btn btn-ghost btn-sm" data-copy="${DISCORD.handle}">Copy “${DISCORD.handle}”</button>
      <a class="btn btn-ghost btn-sm" href="${DISCORD.invite}" target="_blank" rel="noopener" data-track="discord_click" data-track-location="trial_success">Open Discord</a>
      <a class="btn btn-primary btn-sm" href="/track/${esc(token)}">Track my games</a>
    </div>`;
  const alreadyCustomer = `
    <p class="t">You're already a StainBoost customer 🙌</p>
    <p class="muted">The free trial is for first-timers. You can see your exact price in seconds — and your referral link in the dashboard gives friends 20% off.</p>
    <div class="row"><a class="btn btn-primary btn-sm" href="/pricing">Get my price</a><a class="btn btn-ghost btn-sm" href="/dashboard">My dashboard</a></div>`;

  stateBox.addEventListener('click', async (e) => {
    const b = e.target.closest('[data-copy]');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Copied ✓'; } catch {}
  });

  function goSignIn(method) {
    save();
    track('login_required', { method, location: 'free_trial' });
    location.href = '/api/auth/discord-start?return=' + encodeURIComponent('/free-trial?resume=1');
  }

  async function init() {
    if (!form || !trialActive()) return;
    track('trial_view');
    form.querySelector('[data-email-login]').addEventListener('click', () => { save(); track('login_required', { method: 'email', location: 'free_trial' }); });
    const resumed = new URLSearchParams(location.search).has('resume') && restore();
    let user = null;
    try { user = (await fetch('/api/auth/me').then((r) => r.json())).user; } catch {}
    if (!user) return;
    form.querySelector('[data-who]').textContent = `Signed in as ${user.username || 'you'}.`;
    // Already ordered, or already claimed? Say so instead of showing the form.
    try {
      const r = await fetch('/api/order-tracking/mine');
      if (r.ok) {
        const orders = (await r.json()).orders || [];
        const trial = orders.find((o) => o.meta?.kind === 'free_trial');
        if (trial) return show(booked(trial.token, trial.type));
        if (orders.length) return show(alreadyCustomer);
      }
    } catch {}
    if (resumed) { form.querySelector('[data-submit]').focus(); form.querySelector('[data-who]').textContent += ' Press Claim to book your games.'; }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = form.querySelector('[data-err]');
    const btn = form.querySelector('[data-submit]');
    const d = read();
    err.hidden = true;
    if (!d.ign || !d.discord) { err.textContent = 'Add your Riot ID and Discord username.'; err.hidden = false; return; }
    btn.disabled = true;
    try {
      const r = await fetch('/api/order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderType: 'free_trial', ...d }) });
      const b = await r.json().catch(() => ({}));
      if (r.status === 401 && b.requireLogin) return goSignIn('discord');
      if (r.ok) {
        try { localStorage.removeItem(SAVED); } catch {}
        track('trial_claim', { queue: d.type, region: d.region });
        track('generate_lead', { value: 0, currency: 'USD' });
        return show(booked(b.token, d.type));
      }
      if (r.status === 410) { document.documentElement.classList.add('trial-over'); return; }
      if (b.notNew) { track('trial_blocked', { reason: 'not_new' }); return show(alreadyCustomer); }
      if (b.trialUsed && b.token) return show(booked(b.token));
      if (b.trialUsed) track('trial_blocked', { reason: 'used' });
      err.textContent = b.error || 'Could not book the free trial. Try again.';
      err.hidden = false;
    } catch {
      err.textContent = 'Network error. Check your connection and try again.';
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  init();
</script>

<style>
  .ft { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); grid-template-areas: 'head side' 'copy side'; gap: 22px clamp(20px, 4vw, 48px); align-items: start; }
  .ft-head { grid-area: head; display: grid; gap: 14px; }
  .ft-copy { grid-area: copy; display: grid; gap: 16px; }
  .ft-side { grid-area: side; }
  .ft-head h1 { font-size: clamp(2rem, 3.8vw + .6rem, 3.4rem); }
  .ft-count { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-family: var(--font-ui); font-weight: 500; font-size: 1.15rem; color: var(--gold); }
  .ft-count [data-trial-countdown] { font-variant-numeric: tabular-nums; min-width: 17ch; padding: 4px 12px; border-radius: 999px; background: rgba(245, 166, 35, .12); border: 1px solid rgba(245, 166, 35, .45); }
  .ft-count small { font-family: var(--font-body); font-weight: 400; font-size: .85rem; color: var(--muted); }
  .ft-steps { display: grid; gap: 10px; padding-inline-start: 1.3rem; color: rgba(255, 255, 255, .8); }
  .ft-steps b { color: var(--text-strong); }
  .ft-rules ul { display: grid; gap: 6px; margin-block-start: 8px; padding-inline-start: 1.1rem; color: var(--muted); font-size: .92rem; }
  .ft-side { display: grid; gap: 14px; position: sticky; inset-block-start: calc(var(--nav-h) + 16px); }
  .ft-form { display: grid; gap: 14px; border-color: rgba(245, 166, 35, .45); }
  .ft-form-title { font-family: var(--font-display); font-weight: 400; font-size: 1.2rem; color: var(--text-strong); }
  .ft-seg { display: flex; gap: 6px; padding: 4px; border-radius: 14px; background: rgba(0, 0, 0, .25); border: 1px solid rgba(255, 255, 255, .08); width: fit-content; max-width: 100%; }
  .ft-seg label { position: relative; flex: 1 1 auto; }
  .ft-seg input { position: absolute; opacity: 0; inset: 0; }
  .ft-seg span { display: grid; place-items: center; min-width: 52px; min-height: 42px; padding: 6px 14px; border-radius: 10px; font-family: var(--font-ui); font-weight: 500; letter-spacing: .04em; color: rgba(255, 255, 255, .72); cursor: pointer; text-align: center; }
  .ft-seg small { display: block; font-size: .72rem; letter-spacing: 0; color: var(--muted); }
  .ft-seg input:checked + span { background: rgba(196, 181, 253, .14); color: var(--text-strong); }
  .ft-seg input:checked + span small { color: #e9d5ff; }
  .ft-seg input:focus-visible + span { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .ft-note { font-size: .85rem; color: var(--muted); text-align: center; }
  .ft-state { display: grid; gap: 10px; justify-items: start; }
  .ft-state :global(.t) { font-family: var(--font-display); font-weight: 400; color: var(--text-strong); font-size: 1.15rem; }
  .ft-state :global(.tok) { font-family: ui-monospace, monospace; }
  .ft-state :global(.row) { display: flex; flex-wrap: wrap; gap: 8px; }
  .err { color: #fecaca; background: rgba(248, 113, 113, .1); border: 1px solid rgba(248, 113, 113, .35); border-radius: 12px; padding: 10px 12px; }
  @media (max-width: 860px) { .ft { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'side' 'copy'; } .ft-side { position: static; } }
</style>
