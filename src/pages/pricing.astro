---
import Base from '../layouts/Base.astro';
import Configurator from '../components/Configurator.astro';
import OrderSummary from '../components/OrderSummary.astro';
import OrderSuccess from '../components/OrderSuccess.astro';
import ReviewCard from '../components/ReviewCard.astro';
import FaqList from '../components/FaqList.astro';
import RankEmblem from '../components/RankEmblem.astro';
import { WIN_PRICES, RB_TIERS, MASTERS, divisionPrice, formatUSD, rankBoostTotal, lowestWinPrice } from '../data/pricing.js';
import { getVerifiedReviews } from '../data/reviews.js';
import { FAQ, faqSchema } from '../data/faq.js';
import { tierOfWinRank } from '../data/ranks.js';
import { boostProduct, breadcrumbs } from '../data/schema.js';
import '../styles/pricing.css';

const reviews = await getVerifiedReviews();
const faqItems = FAQ.flatMap((g) => g.items).filter((i) => /pay|refund|start|banned|login|free win|loses/i.test(i.q));
const divRows = [];
RB_TIERS.slice(0, MASTERS).forEach((t, i) => {
  if (t === 'Diamond') {
    divRows.push({ tier: t, label: 'Diamond IV–III', solo: divisionPrice(i, 0, 'solo'), duo: divisionPrice(i, 0, 'duo') });
    divRows.push({ tier: t, label: 'Diamond II–I', solo: divisionPrice(i, 2, 'solo'), duo: divisionPrice(i, 2, 'duo') });
  } else divRows.push({ tier: t, label: t, solo: divisionPrice(i, 0, 'solo'), duo: divisionPrice(i, 0, 'duo') });
});
const total = formatUSD(rankBoostTotal({ fromTier: 2, fromDiv: 2, toTier: 3, toDiv: 0, type: 'solo', lp: 10 }));
---
<Base
  title="ELO Boost Prices – Middle East Server | Rank Boost & Net Wins | StainBoost"
  description={`Instant League of Legends boost prices for the Middle East server. Rank boost from ${formatUSD(divisionPrice(0, 0, 'solo'))} per division, net wins from ${formatUSD(lowestWinPrice())} — pay for 5, get 6. Played by Stain, #1 Master Yi on ME. Refund if not started.`}
  path="/pricing"
  active="/pricing"
  schema={[boostProduct(reviews), faqSchema(faqItems), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing' }])]}
>
  <div class="wrap pr-top">
    <OrderSuccess />
    <div class="wiz" data-layout data-step-now="1">
      <header class="pr-head" data-loc="pricing_head" data-wiz-head>
        <p class="eyebrow">ELO boost · ME, EUW &amp; EUNE</p>
        <h1>Your boost, <span class="grad">priced instantly.</span></h1>
        <p class="lead">Four quick questions, then your exact price. Every game is played by Stain himself.</p>
      </header>

      <ol class="wiz-steps" aria-label="Order steps" data-wiz-steps>
        {['Boost', 'Now', 'Goal', 'Play', 'Order'].map((label, i) => (
          <li><button type="button" data-goto={i + 1} data-step-label={i + 1} aria-current={i === 0 ? 'step' : undefined} disabled={i > 0}><span class="bar" aria-hidden="true"></span><span class="lbl">{label}</span></button></li>
        ))}
      </ol>

      <Configurator />
      <OrderSummary />

      <div class="wiz-bar" data-wiz-bar hidden>
        <button type="button" class="wb-back" data-wiz-back aria-label="Back to the previous question"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></button>
        <div class="wb-info">
          <span class="wb-route" data-wb-route>Silver II → Gold IV</span>
          <span class="wb-price num" data-wb-price>{total}</span>
        </div>
        <button type="button" class="btn btn-primary wb-next" data-wiz-next>Next <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
      </div>
    </div>
  </div>

  <section class="section prices" data-loc="price_tables">
    <div class="wrap">
      <details class="all-prices">
        <summary>
          <span><span class="eyebrow">Price list</span><span class="ap-title">See every price, up front</span><span class="ap-sub">Rank boost per division · net wins per win · solo and duo</span></span>
          <span class="ap-plus" aria-hidden="true"></span>
        </summary>
      <div class="tables">
        <div class="card">
          <table class="ptable">
            <caption>Rank boost<span class="cap-sub">Price per division</span></caption>
            <thead><tr><th scope="col">Tier</th><th scope="col">Solo</th><th scope="col">Duo</th></tr></thead>
            <tbody>
              {divRows.map((r) => <tr><th scope="row"><RankEmblem tier={r.tier} size={24} />{r.label}</th><td>{formatUSD(r.solo)}</td><td class="duo">{formatUSD(r.duo)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <div class="card">
          <table class="ptable">
            <caption>Net wins<span class="cap-sub">Price per win · pay for 5, get 6</span></caption>
            <thead><tr><th scope="col">Rank</th><th scope="col">Solo</th><th scope="col">Duo</th></tr></thead>
            <tbody>
              {Object.entries(WIN_PRICES).map(([name, p]) => <tr><th scope="row"><RankEmblem tier={tierOfWinRank(name)} size={24} />{name.replace('-', '–')}</th><td>{formatUSD(p.solo)}</td><td class="duo">{formatUSD(p.duo)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
      </details>
    </div>
  </section>

  <section class="section" data-loc="pricing_reviews">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Verified reviews</p>
        <h2>From buyers with a completed order.</h2>
      </div>
      <div class="grid-3">{reviews.slice(0, 3).map((r, i) => <ReviewCard {...r} delay={i * 0.06} />)}</div>
      <p class="center" style="margin-top:20px"><a href="/reviews">All verified reviews →</a></p>
    </div>
  </section>

  <section class="section" data-loc="faq_pricing">
    <div class="wrap-narrow">
      <div class="section-head center">
        <p class="eyebrow">Questions</p>
        <h2>Price, payment &amp; safety.</h2>
      </div>
      <FaqList items={faqItems} loc="faq_pricing" />
      <p class="center" style="margin-top:20px"><a href="/faq">All questions →</a></p>
    </div>
  </section>

</Base>

<script>
  import '../scripts/configurator.js';
</script>
