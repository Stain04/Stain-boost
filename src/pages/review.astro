---
import Base from '../layouts/Base.astro';
---
<Base title="Leave a review – StainBoost" description="Leave a verified review for your completed StainBoost order." path="/review" noindex minimal>
  <section class="section-tight">
    <div class="wrap-narrow rv">
      <p class="eyebrow">Order complete</p>
      <h1>Leave a review</h1>
      <p class="muted">A few words go a long way — only buyers with a completed order can post, which is why people trust these reviews.</p>

      <div class="card state" data-state><p>Checking your order…</p></div>

      <form class="card form" data-form hidden>
        <p class="for"><span class="label">Reviewing</span><span data-summary>—</span></p>
        <div class="field"><label for="rvName">Display name</label><input id="rvName" class="input" maxlength="60" required /></div>
        <div class="field"><label for="rvRank">Rank reached (optional)</label><input id="rvRank" class="input" maxlength="40" placeholder="e.g. Silver IV → Gold IV" /></div>
        <fieldset class="field stars-f">
          <legend class="field-label">Rating</legend>
          <div class="stars">
            {[5, 4, 3, 2, 1].map((n) => <label><input type="radio" name="stars" value={n} checked={n === 5} /><span aria-hidden="true">★</span><span class="visually-hidden">{n} stars</span></label>)}
          </div>
        </fieldset>
        <div class="field"><label for="rvText">Your review</label><textarea id="rvText" class="input" rows="5" maxlength="500" required placeholder="How was it? Speed, communication, safety — anything the next buyer should know."></textarea></div>
        <button class="btn btn-gold btn-block" type="submit">Post my review</button>
        <p class="err" data-err role="alert" hidden></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { track } from '../scripts/analytics.js';
  const $ = (s) => document.querySelector(s);
  const TOKEN_RE = /^SB-[A-Z0-9]{4}-[A-Z0-9]{4}$/;
  const m = location.pathname.match(/\/review\/(SB-[A-Z0-9]{4}-[A-Z0-9]{4})/i);
  const token = m ? m[1].toUpperCase() : (new URLSearchParams(location.search).get('token') || '').toUpperCase();
  const state = (html) => { $('[data-state]').innerHTML = html; $('[data-state]').hidden = false; $('[data-form]').hidden = true; };
  const back = '<a class="btn btn-ghost btn-sm" href="/dashboard">Back to my orders</a>';

  if (!TOKEN_RE.test(token)) state(`<p class="t">Invalid review link</p><p class="muted">Open the review link from your order page once the order is completed.</p>${back}`);
  else fetch('/api/auth/me').then((r) => r.json()).then((d) => {
    if (!d.user) { location.href = '/login?return=' + encodeURIComponent(location.pathname); return; }
    return fetch('/api/order-tracking/status?token=' + encodeURIComponent(token)).then((r) => r.json().then((b) => ({ s: r.status, b, user: d.user })));
  }).then((res) => {
    if (!res) return;
    const { s, b, user } = res;
    if (s === 401) { location.href = '/login?return=' + encodeURIComponent(location.pathname); return; }
    if (s === 403) return state(`<p class="t">Not your order</p><p class="muted">Sign in with the account you used when you placed this order.</p>${back}`);
    if (s !== 200) return state(`<p class="t">Order not found</p><p class="muted">${b.error || 'This order no longer exists.'}</p>${back}`);
    if (b.status !== 'completed') return state(`<p class="t">Not completed yet</p><p class="muted">You can review once Stain marks the order as completed.</p><a class="btn btn-ghost btn-sm" href="/track/${b.token}">Track it live</a>`);
    if (!b.reviewable) return state(`<p class="t">⭐ Thanks — already reviewed</p><p class="muted">This order's review is posted on the reviews page.</p><a class="btn btn-ghost btn-sm" href="/reviews">See reviews</a>`);
    $('[data-summary]').textContent = b.summary || b.token;
    $('#rvName').value = user.username || '';
    if (b.meta?.kind === 'rank_boost') $('#rvRank').value = `${b.meta.from} → ${b.meta.to}`;
    else if (b.currentRank) $('#rvRank').value = b.currentRank;
    $('[data-state]').hidden = true;
    $('[data-form]').hidden = false;
  }).catch(() => state(`<p class="t">Network error</p><p class="muted">Check your connection and try again.</p>`));

  $('[data-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('[data-err]');
    const name = $('#rvName').value.trim(), rank = $('#rvRank').value.trim(), text = $('#rvText').value.trim();
    const stars = +document.querySelector('input[name="stars"]:checked').value;
    if (!name || !text) { err.textContent = 'Add a display name and a few words.'; err.hidden = false; return; }
    const r = await fetch('/api/reviews', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, name, rank, stars, text }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    if (r && r.ok) { track('review_submit', { stars }); state(`<p class="t">⭐ Thanks for the review!</p><p class="muted">It's live on the reviews page. Want to keep climbing?</p><div class="row"><a class="btn btn-primary btn-sm" href="/pricing">Get my next price</a><a class="btn btn-ghost btn-sm" href="/reviews">See reviews</a></div>`); }
    else { err.textContent = d.error || 'Could not post the review.'; err.hidden = false; }
  });
</script>

<style>
  .rv { display: grid; gap: 14px; }
  .rv h1 { font-size: clamp(1.8rem, 3vw + .6rem, 2.5rem); }
  .state { display: grid; gap: 10px; justify-items: start; }
  .state :global(.t) { font-family: var(--font-display); font-weight: 900; color: #fff; font-size: 1.15rem; }
  .form { display: grid; gap: 14px; }
  .for { display: grid; gap: 2px; color: #fff; }
  .stars-f { border: 0; padding: 0; }
  .stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; }
  .stars label { position: relative; font-size: 2.2rem; line-height: 1; color: rgba(255, 255, 255, .18); cursor: pointer; }
  .stars input { position: absolute; opacity: 0; inset: 0; }
  .stars label:has(input:checked), .stars label:has(input:checked) ~ label { color: var(--gold); text-shadow: 0 0 12px rgba(245, 166, 35, .5); }
  .stars label:has(input:focus-visible) { outline: 2px solid var(--cyan); border-radius: 6px; }
  textarea.input { resize: vertical; min-height: 120px; }
  .err { color: #fecaca; background: rgba(248, 113, 113, .1); border: 1px solid rgba(248, 113, 113, .35); border-radius: 12px; padding: 10px 12px; }
</style>
