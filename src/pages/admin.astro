---
import Base from '../layouts/Base.astro';
---
<Base title="Admin – StainBoost" description="StainBoost admin." path="/admin" noindex minimal chat={false} promo={false}>
  <section class="section-tight">
    <div class="wrap adm">
      <div class="gate card" data-gate hidden>
        <h1>Admin</h1>
        <p class="muted">Sign in with your admin Discord account, or use the admin key.</p>
        <a class="btn btn-discord" href="/login?return=/admin">Sign in</a>
        <form class="keyrow" data-keyform>
          <label class="visually-hidden" for="akey">Admin key</label>
          <input id="akey" class="input" type="password" autocomplete="current-password" placeholder="Admin key" />
          <button class="btn btn-ghost" type="submit">Unlock</button>
        </form>
        <p class="err" data-gate-err hidden></p>
      </div>

      <div data-app hidden>
        <div class="bar card">
          <div>
            <p class="eyebrow">Control panel</p>
            <p class="who" data-who>—</p>
          </div>
          <div class="online">
            <span class="chip" data-online-chip>Status: —</span>
            <label class="visually-hidden" for="onHours">Online for</label>
            <select id="onHours" class="select sm"><option value="2">2 h</option><option value="4" selected>4 h</option><option value="8">8 h</option><option value="12">12 h</option></select>
            <button class="btn btn-primary btn-sm" type="button" data-go-online>I'm online</button>
            <button class="btn btn-ghost btn-sm" type="button" data-go-offline>Go offline</button>
          </div>
        </div>

        <div class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-tab="orders">Orders</button>
          <button role="tab" aria-selected="false" data-tab="reviews">Review requests</button>
          <button role="tab" aria-selected="false" data-tab="waitlist">EU waitlist</button>
        </div>

        <!-- ORDERS -->
        <div data-view="orders">
          <div class="toolbar">
            <div class="chips" data-filters></div>
            <input class="input search" type="search" placeholder="Search IGN, Discord, token…" data-search />
            <button class="btn btn-ghost btn-sm" type="button" data-refresh>↻ Refresh</button>
          </div>
          <div class="list" data-list><p class="muted">Loading orders…</p></div>
        </div>

        <!-- ORDER DETAIL -->
        <div data-view="detail" hidden>
          <button class="btn btn-ghost btn-sm" type="button" data-back>← All orders</button>
          <div class="card"><dl class="meta" data-meta></dl></div>
          <div class="tools">
            <form class="card tool" data-save>
              <h2>Status &amp; progress</h2>
              <div class="two">
                <div class="field"><label for="fStatus">Status</label><select id="fStatus" class="select">
                  <option value="awaiting_payment">Awaiting payment</option><option value="payment_verified">Payment verified</option><option value="queued">Queued</option>
                  <option value="in_progress">In progress</option><option value="paused">Paused</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option>
                </select></div>
                <div class="field"><label for="fWins">Net wins done</label><input id="fWins" class="input" type="number" min="0" /></div>
              </div>
              <div class="three">
                <div class="field"><label for="fRank">Current rank</label><input id="fRank" class="input" maxlength="40" placeholder="Gold II" /></div>
                <div class="field"><label for="fLp">Current LP</label><input id="fLp" class="input" type="number" min="0" max="9999" /></div>
                <div class="field"><label for="fEta">ETA</label><input id="fEta" class="input" maxlength="80" placeholder="2 days" /></div>
              </div>
              <button class="btn btn-primary" type="submit">Save</button>
            </form>
            <form class="card tool" data-game>
              <h2>Log a game</h2>
              <div class="two">
                <div class="field"><label for="gRes">Result</label><select id="gRes" class="select"><option value="W">Win</option><option value="L">Loss</option><option value="R">Remake</option></select></div>
                <div class="field"><label for="gLp">LP change</label><input id="gLp" class="input" type="number" min="-99" max="99" placeholder="+22" /></div>
              </div>
              <div class="two">
                <div class="field"><label for="gChamp">Champion</label><input id="gChamp" class="input" maxlength="30" value="Master Yi" /></div>
                <div class="field"><label for="gKda">KDA</label><input id="gKda" class="input" maxlength="20" placeholder="12/2/6" /></div>
              </div>
              <button class="btn btn-gold" type="submit">Log game</button>
            </form>
            <form class="card tool" data-note>
              <h2>Post an update</h2>
              <textarea id="fNote" class="input" rows="3" maxlength="500" placeholder="Starting your next session now…"></textarea>
              <button class="btn btn-primary" type="submit">Post</button>
            </form>
            <div class="card tool">
              <h2>Chat</h2>
              <div class="msgs" data-msgs></div>
              <form class="send" data-chat><input class="input" id="chatIn" maxlength="1000" placeholder="Reply…" /><button class="btn btn-primary btn-sm" type="submit">Send</button></form>
            </div>
          </div>
          <p class="toast" data-toast role="status" hidden></p>
        </div>

        <!-- REVIEW REQUESTS -->
        <div data-view="reviews" hidden>
          <p class="muted">Completed orders without a review yet. Send the customer their link — they sign in with the account they ordered with.</p>
          <div class="list" data-reviews></div>
        </div>

        <!-- WAITLIST -->
        <div data-view="waitlist" hidden>
          <div class="list" data-waitlist><p class="muted">Loading…</p></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { STATUS, esc, ago } from '../scripts/account.js';
  const $ = (s) => document.querySelector(s);
  let key = '', session = false, orders = [], filter = 'active', current = null;
  try { key = sessionStorage.getItem('sb_admin_key') || ''; } catch {}
  const H = (json) => ({ ...(json ? { 'Content-Type': 'application/json' } : {}), ...(key && !session ? { 'x-admin-key': key } : {}) });
  const api = (url, opts = {}) => fetch(url, { ...opts, headers: H(!!opts.body) }).then((r) => r.json().then((b) => ({ s: r.status, b })));
  const toast = (t) => { const n = $('[data-toast]'); n.textContent = t; n.hidden = false; setTimeout(() => { n.hidden = true; }, 2500); };

  fetch('/api/auth/me').then((r) => r.json()).then((d) => {
    if (d.user && d.user.isAdmin) { session = true; $('[data-who]').textContent = '@' + d.user.username; start(); }
    else if (key) tryKey(key);
    else $('[data-gate]').hidden = false;
  }).catch(() => { $('[data-gate]').hidden = false; });

  $('[data-keyform]').addEventListener('submit', (e) => { e.preventDefault(); tryKey($('#akey').value.trim()); });
  async function tryKey(k) {
    key = k;
    const r = await api('/api/order-tracking/list');
    if (r.s === 200) { try { sessionStorage.setItem('sb_admin_key', k); } catch {} $('[data-who]').textContent = 'Admin key'; orders = r.b.orders || []; start(true); }
    else { key = ''; try { sessionStorage.removeItem('sb_admin_key'); } catch {} $('[data-gate]').hidden = false; const e = $('[data-gate-err]'); e.textContent = r.b.error || 'Invalid key.'; e.hidden = false; }
  }

  function start(preloaded) {
    $('[data-gate]').hidden = true; $('[data-app]').hidden = false;
    loadStatus();
    preloaded ? renderList() : loadList();
    setInterval(() => { if (!document.hidden && !$('[data-view="orders"]').hidden) loadList(); }, 20000);
  }

  // ── Online switch ──
  function loadStatus() {
    fetch('/api/status').then((r) => r.json()).then((s) => {
      const c = $('[data-online-chip]');
      c.className = 'chip ' + (s.online ? 'chip-green' : '');
      c.textContent = s.online ? `Online until ${new Date(s.until).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}` : (s.known ? 'Offline' : 'Status never set');
    });
  }
  const setOnline = async (online) => {
    const r = await api('/api/status', { method: 'POST', body: JSON.stringify({ online, hours: +$('#onHours').value }) });
    toast(r.s === 200 ? (online ? 'You show as online.' : 'You show as offline.') : (r.b.error || 'Failed.'));
    loadStatus();
  };
  $('[data-go-online]').addEventListener('click', () => setOnline(true));
  $('[data-go-offline]').addEventListener('click', () => setOnline(false));

  // ── Tabs ──
  document.querySelectorAll('[data-tab]').forEach((t) => t.addEventListener('click', () => show(t.dataset.tab)));
  function show(view) {
    document.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === view)));
    document.querySelectorAll('[data-view]').forEach((v) => { v.hidden = v.dataset.view !== view; });
    if (view === 'reviews') renderReviews();
    if (view === 'waitlist') loadWaitlist();
  }

  // ── Orders ──
  const FILTERS = { active: 'Active', claimed: '💸 Says paid', awaiting_payment: 'Awaiting pay', payment_verified: 'Verified', queued: 'Queued', in_progress: 'In progress', completed: 'Completed', all: 'All' };
  const match = (o, f) => f === 'all' || (f === 'active' ? !['completed', 'cancelled'].includes(o.status) : f === 'claimed' ? (o.status === 'awaiting_payment' && o.paymentClaim) : o.status === f);
  function loadList() { api('/api/order-tracking/list').then((r) => { if (r.s === 200) { orders = r.b.orders || []; renderList(); } }); }
  $('[data-refresh]').addEventListener('click', loadList);
  $('[data-search]').addEventListener('input', renderList);
  function renderList() {
    $('[data-filters]').innerHTML = Object.entries(FILTERS).map(([k, v]) => `<button type="button" class="fchip" aria-pressed="${k === filter}" data-f="${k}">${v} <span>${orders.filter((o) => match(o, k)).length}</span></button>`).join('');
    document.querySelectorAll('[data-f]').forEach((b) => b.addEventListener('click', () => { filter = b.dataset.f; renderList(); }));
    const q = $('[data-search]').value.trim().toLowerCase();
    const list = orders.filter((o) => match(o, filter) && (!q || [o.token, o.ign, o.discord, o.summary].join(' ').toLowerCase().includes(q)));
    $('[data-list]').innerHTML = list.length ? list.map((o) => `<button type="button" class="card row-o" data-open="${esc(o.token)}">
      <span class="pill pill-${esc(o.status)}">${esc(STATUS[o.status] || o.status)}</span>
      <span class="o-main"><b>${esc(o.ign || '—')}</b> · ${esc(o.discord || '')}${o.paymentClaim && o.status === 'awaiting_payment' ? ` <em class="claim">💸 says paid (${esc(o.paymentClaim.method)})</em>` : ''}<small>${esc(o.summary || '')}</small></span>
      <span class="o-side"><b class="gold">$${esc(o.total || '')}</b><small>${ago(o.updatedAt || o.createdAt)}</small></span>
    </button>`).join('') : '<p class="muted">No orders here.</p>';
    document.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open)));
  }

  async function open(token) {
    const r = await api('/api/order-tracking/status?token=' + encodeURIComponent(token));
    if (r.s !== 200) { toast(r.b.error || 'Could not open order.'); return; }
    const full = orders.find((o) => o.token === token) || {};
    current = { ...full, ...r.b };
    renderDetail();
    document.querySelectorAll('[data-view]').forEach((v) => { v.hidden = v.dataset.view !== 'detail'; });
    chat();
  }
  $('[data-back]').addEventListener('click', () => { current = null; show('orders'); loadList(); });
  function renderDetail() {
    const o = current;
    const row = (k, v) => `<div><dt>${k}</dt><dd>${esc(v ?? '—')}</dd></div>`;
    $('[data-meta]').innerHTML = row('Token', o.token) + row('Status', STATUS[o.status] || o.status) + row('Order', o.summary) + row('Total', o.total ? '$' + o.total : '—')
      + row('IGN', o.ign) + row('Discord', o.discord) + row('Server', (o.region || 'me').toUpperCase()) + row('Queue', o.type) + row('Flash', o.flash || 'ask on Discord')
      + row('Payment', o.paymentClaim ? `Customer says: ${o.paymentClaim.method}, ${ago(o.paymentClaim.ts)}` : 'No claim yet')
      + row('Referral', o.referral ? `${o.referral.code}${o.referral.credited ? ` · $${o.referral.credited} credited` : ''}` : '—')
      + row('Credit used', o.creditUsed ? '$' + (+o.creditUsed).toFixed(2) : '—')
      + (o.meta?.kind === 'win_boost' ? row('Net wins', `${o.meta.winsDone || 0} / ${o.meta.wins}`)
        : o.meta?.kind === 'free_trial' ? row('Free games', `${(o.games || []).length} / ${o.meta.games} (log each game below)`)
        : row('Range', `${o.meta?.from || ''} → ${o.meta?.to || ''}`))
      + row('Updated', ago(o.updatedAt));
    $('#fStatus').value = o.status;
    $('#fRank').value = o.currentRank || '';
    $('#fLp').value = o.currentLp || '';
    $('#fEta').value = o.eta || '';
    const win = o.meta?.kind === 'win_boost';
    $('#fWins').disabled = !win;
    $('#fWins').value = win ? (o.meta.winsDone || 0) : '';
  }
  async function update(payload, msg) {
    const r = await api('/api/order-tracking/update', { method: 'POST', body: JSON.stringify({ ...payload, token: current.token, ...(key && !session ? { adminKey: key } : {}) }) });
    if (r.s === 200) { current = { ...current, ...r.b.order }; renderDetail(); toast(msg); } else toast(r.b.error || 'Failed.');
    return r.s === 200;
  }
  $('[data-save]').addEventListener('submit', (e) => {
    e.preventDefault();
    const p = { status: $('#fStatus').value, currentRank: $('#fRank').value.trim(), currentLp: parseInt($('#fLp').value, 10) || 0, eta: $('#fEta').value.trim() };
    const w = parseInt($('#fWins').value, 10); if (!isNaN(w)) p.winsDone = w;
    update(p, 'Saved.');
  });
  $('[data-game]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const g = { result: $('#gRes').value, champion: $('#gChamp').value.trim(), kda: $('#gKda').value.trim() };
    if ($('#gLp').value !== '') g.lp = parseInt($('#gLp').value, 10);
    if (await update({ addGame: g }, 'Game logged.')) { $('#gKda').value = ''; $('#gLp').value = ''; }
  });
  $('[data-note]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const n = $('#fNote').value.trim(); if (!n) return;
    if (await update({ addNote: n }, 'Update posted.')) $('#fNote').value = '';
  });
  function chat() {
    if (!current) return;
    api('/api/order-tracking/chat?token=' + encodeURIComponent(current.token)).then((r) => {
      const msgs = (r.b && r.b.messages) || [];
      const box = $('[data-msgs]');
      box.innerHTML = msgs.length ? msgs.map((m) => `<div class="b ${m.from === 'stain' ? 'b-me' : 'b-them'}">${esc(m.text)}<small>${m.from === 'stain' ? 'You' : 'Customer'} · ${ago(m.ts)}</small></div>`).join('') : '<p class="muted">No messages yet.</p>';
      box.scrollTop = box.scrollHeight;
    });
  }
  setInterval(() => { if (current && !document.hidden) chat(); }, 12000);
  $('[data-chat]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const t = $('#chatIn').value.trim(); if (!t) return;
    await api('/api/order-tracking/chat', { method: 'POST', body: JSON.stringify({ token: current.token, text: t, ...(key && !session ? { adminKey: key } : {}) }) });
    $('#chatIn').value = ''; chat();
  });

  // ── Review requests ──
  function renderReviews() {
    const list = orders.filter((o) => o.reviewable);
    $('[data-reviews]').innerHTML = list.length ? list.map((o) => {
      const link = `https://www.stainboost.com/review/${o.token}`;
      const msg = `Hey! Thanks again for boosting with StainBoost 🙏 If you have 30 seconds, could you leave a quick review? Sign in with the same account you ordered with, then open: ${link}`;
      return `<div class="card row-r"><span><b>${esc(o.discord || o.ign || '—')}</b><small>${esc(o.summary || '')} · ${ago(o.updatedAt)}</small></span>
        <span class="r-btns"><button type="button" class="btn btn-ghost btn-sm" data-copy="${esc(link)}">Copy link</button><button type="button" class="btn btn-primary btn-sm" data-copy="${esc(msg)}">Copy message</button></span></div>`;
    }).join('') : '<p class="muted">No completed orders waiting for a review. (Orders are deleted 90 days after they were placed.)</p>';
    document.querySelectorAll('[data-reviews] [data-copy]').forEach((b) => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); } catch {}
      const t = b.textContent; b.textContent = 'Copied ✓'; setTimeout(() => { b.textContent = t; }, 1400);
    }));
  }

  // ── EU waitlist ──
  function loadWaitlist() {
    api('/api/notify').then((r) => {
      if (r.s !== 200) { $('[data-waitlist]').innerHTML = `<p class="muted">${esc(r.b.error || 'Could not load.')}</p>`; return; }
      $('[data-waitlist]').innerHTML = Object.entries(r.b).map(([region, list]) => `<div class="card"><h2>${region.toUpperCase()} · ${list.length}</h2>${list.length ? `<ul class="wl">${list.map((x) => `<li>${esc(x.contact)} <small>${ago(x.ts)}</small></li>`).join('')}</ul>` : '<p class="muted">No sign-ups yet.</p>'}</div>`).join('');
    });
  }
</script>

<style is:global>
  /* global so the markup this page builds in JS is styled too; every rule stays under .adm */
  .adm { display: grid; gap: 16px; }
  .adm .gate { display: grid; gap: 12px; justify-items: start; max-width: 460px; }
  .adm .keyrow { display: flex; gap: 8px; width: 100%; }
  .adm .err { color: #fecaca; }
  .adm .bar { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; margin-block-end: 14px; }
  .adm .who { font-family: var(--font-ui); font-weight: 500; color: var(--text-strong); }
  .adm .online { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .adm .select.sm { width: auto; min-height: 40px; }
  .adm .tabs { display: flex; gap: 6px; margin-block-end: 14px; flex-wrap: wrap; }
  .adm .tabs button { padding: 8px 16px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .03); color: var(--text); font-family: var(--font-ui); font-weight: 500; letter-spacing: .06em; }
  .adm .tabs [aria-selected='true'] { border-color: var(--purple-light); background: rgba(196, 181, 253, .2); }
  .adm .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-block-end: 12px; }
  .adm .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .adm .fchip { padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .03); color: var(--text); font-family: var(--font-ui); font-weight: 500; font-size: .85rem; }
  .adm .fchip span { color: var(--muted); }
  .adm .fchip[aria-pressed='true'] { border-color: var(--purple-light); background: rgba(196, 181, 253, .2); }
  .adm .search { max-width: 280px; min-height: 40px; }
  .adm .list { display: grid; gap: 8px; }
  .adm .row-o { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; text-align: start; color: inherit; padding: 14px 16px; }
  .adm .o-main small, .adm .o-side small, .adm .row-r small { display: block; color: var(--muted); font-size: .85rem; }
  .adm .o-side { text-align: end; }
  .adm .claim { font-style: normal; color: var(--gold); font-weight: 600; }
  .adm .meta { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .adm .meta dt { font-family: var(--font-ui); font-weight: 400; font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .adm .meta dd { margin: 0; color: var(--text-strong); word-break: break-word; }
  .adm .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-block-start: 14px; }
  .adm .tool { display: grid; gap: 12px; align-content: start; }
  .adm .tool h2 { font-size: .95rem; letter-spacing: .1em; }
  .adm .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .adm .three { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
  .adm .msgs { display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto; }
  .adm .b { max-width: 85%; padding: 8px 12px; border-radius: 12px; font-size: .92rem; }
  .adm .b small { display: block; font-size: .72rem; opacity: .7; }
  .adm .b-me { align-self: flex-end; background: rgba(196, 181, 253, .14); color: var(--text-strong); }
  .adm .b-them { align-self: flex-start; background: rgba(143, 227, 245, .08); border: 1px solid rgba(143, 227, 245, .25); }
  .adm .send { display: flex; gap: 8px; }
  .adm .toast { position: fixed; inset-inline-end: 20px; inset-block-end: 90px; padding: 10px 16px; border-radius: 12px; background: var(--card-solid); border: 1px solid rgba(52, 211, 153, .5); color: #d1fae5; z-index: 90; }
  .adm .row-r { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .adm .r-btns { display: flex; gap: 8px; }
  .adm .wl { list-style: none; padding: 0; display: grid; gap: 6px; margin-block-start: 8px; }
  .adm textarea.input { resize: vertical; }
  @media (max-width: 860px) { .adm .tools { grid-template-columns: 1fr; } .adm .three { grid-template-columns: 1fr; } .adm .row-o { grid-template-columns: 1fr; } .adm .o-side { text-align: start; } }
</style>
