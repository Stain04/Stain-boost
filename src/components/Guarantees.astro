---
import { GUARANTEES } from '../data/site.js';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const icons = [
  '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
  '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
];
---
<ul class:list={['guarantees', { compact }]}>
  {GUARANTEES.map((g, i) => (
    <li>
      <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></span>
      <span><strong>{g.title}</strong>{!compact && <span class="t">{g.text}</span>}</span>
    </li>
  ))}
</ul>

<style>
.guarantees { list-style: none; padding: 0; display: grid; gap: 18px; }
  li { display: flex; gap: 14px; align-items: flex-start; }
  .ic { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 50%; color: var(--lav); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .35); }
  .ic svg { width: 17px; height: 17px; stroke-width: 1.6; }
  strong { display: block; font-weight: 400; font-size: 1.04rem; color: var(--text-strong); }
  .t { display: block; font-size: .95rem; color: var(--muted); line-height: 1.55; }
  .compact { gap: 12px; }
  .compact .ic { width: 30px; height: 30px; }
  .compact .ic svg { width: 14px; height: 14px; }
  .compact strong { font-size: .98rem; padding-block-start: 4px; }
</style>
