---
// Site-wide free-trial bar. Rendered only while the promo runs (src/data/promo.js);
// after the deadline the page hides it before first paint (see Base.astro) and the API refuses claims.
import { FREE_TRIAL, TRIAL_ENDS_MS } from '../data/promo.js';
---
<div class="trial-bar" data-trial data-loc="trial_bar">
  <a class="wrap tb" href="/free-trial" data-track="cta_click" data-track-location="trial_bar">
    <span class="tb-gift" aria-hidden="true">🎁</span>
    <span class="tb-text">
      <b class="tb-long">New here? Your first {FREE_TRIAL.games} games are free.</b>
      <b class="tb-short">{FREE_TRIAL.games} FREE games</b>
      <span class="tb-sub"> No payment · 2 days only</span>
    </span>
    <span class="tb-count tb-long" data-trial-countdown data-end={TRIAL_ENDS_MS}>Ends Fri 2 Oct</span>
    <span class="tb-count tb-short" data-trial-countdown data-prefix="⏳ " data-end={TRIAL_ENDS_MS}>⏳ Fri 2 Oct</span>
    <span class="tb-go">Claim →</span>
  </a>
</div>

<style>
  .trial-bar { position: relative; z-index: 51; background: rgba(8, 6, 26, .72); box-shadow: inset 0 -1px 0 rgba(245, 198, 106, .22); }
  .tb {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    min-height: 40px; padding-block: 7px; color: var(--text); text-decoration: none; font-size: .88rem; letter-spacing: .02em;
  }
  .tb-gift { font-size: .95rem; }
  .tb-text b { font-weight: 500; color: var(--text-strong); }
  .tb-sub { color: var(--muted); }
  .tb-short { display: none; }
  .tb-text, .tb-count, .tb-go { white-space: nowrap; }
  .tb-count { display: inline-block; min-width: 15.5ch; text-align: center; font-variant-numeric: tabular-nums; letter-spacing: .06em; color: var(--gold); }
  .tb-count.tb-short { display: none; }
  .tb-go { color: var(--gold); text-decoration: underline; text-decoration-color: rgba(245, 198, 106, .45); text-underline-offset: 5px; }
  .tb:hover .tb-go { text-decoration-color: var(--gold); }
  .tb:focus-visible { outline: 1.5px solid var(--lav); outline-offset: -3px; }
  @media (max-width: 720px) {
    .tb { gap: 9px; font-size: .82rem; }
    .tb-long, .tb-sub { display: none; }
    .tb-short { display: inline; }
    .tb-count.tb-long { display: none; }
    .tb-count.tb-short { display: inline-block; min-width: 11.5ch; }
  }
  @media (max-width: 360px) { .tb-gift { display: none; } }
</style>
