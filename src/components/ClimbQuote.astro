---
// "The Climb" — hero quote. Server-rendered in its final state (works without JS);
// src/scripts/climb.js animates the climb and keeps the price live.
import { RB_TIERS, MASTERS, LP_OPTIONS, rankName, rankPosition, rankBoostTotal, formatUSD } from '../data/pricing.js';

const def = { fromTier: 2, fromDiv: 2, toTier: 3, toDiv: 0, type: 'solo' };
const price = rankBoostTotal({ ...def, lp: LP_OPTIONS[0].value, lpGain: 1 });
const divs = rankPosition(def.toTier, def.toDiv) - rankPosition(def.fromTier, def.fromDiv);

const groups = RB_TIERS.slice(0, MASTERS).map((tier, t) => ({ tier, opts: [0, 1, 2, 3].map((d) => ({ value: `${t}-${d}`, label: rankName(t, d), pos: t * 4 + d })) }));
const fromPos = rankPosition(def.fromTier, def.fromDiv);
const href = `/pricing?mode=rank&from=${def.fromTier}-${def.fromDiv}&to=${def.toTier}-${def.toDiv}&queue=${def.type}`;
---
<div class="climb card" data-climb data-loc="hero_quote">
  <div class="pickers">
    <div class="field">
      <label for="q-from">I'm in</label>
      <select id="q-from" class="select" data-from>
        {groups.map((g) => (
          <optgroup label={g.tier}>
            {g.opts.map((o) => <option value={o.value} selected={o.value === `${def.fromTier}-${def.fromDiv}`}>{o.label}</option>)}
          </optgroup>
        ))}
      </select>
    </div>
    <svg class="pick-arrow flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    <div class="field">
      <label for="q-to">I want</label>
      <select id="q-to" class="select" data-to>
        {groups.map((g) => (
          <optgroup label={g.tier}>
            {g.opts.map((o) => <option value={o.value} disabled={o.pos <= fromPos} selected={o.value === `${def.toTier}-${def.toDiv}`}>{o.label}</option>)}
          </optgroup>
        ))}
        <option value="7-0">Masters</option>
      </select>
    </div>
  </div>

  <fieldset class="queue">
    <legend class="visually-hidden">How do you want to play?</legend>
    <label><input type="radio" name="q-queue" value="solo" checked /><span><b>Solo</b> Stain plays</span></label>
    <label><input type="radio" name="q-queue" value="duo" /><span><b>Duo</b> You play with him</span></label>
  </fieldset>

  <div class="result">
    <div>
      <p class="route" data-route>{rankName(def.fromTier, def.fromDiv)} → {rankName(def.toTier, def.toDiv)}</p>
      <p class="meta" data-meta>{divs} divisions · solo</p>
    </div>
    <p class="price num" data-price>{formatUSD(price)}</p>
  </div>

  <a class="btn btn-primary btn-block btn-lg" data-cta href={href}>
    Boost me to <span data-cta-to>{rankName(def.toTier, def.toDiv)}</span>
    <svg class="flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
  <p class="fine">For 0–20 LP in your current division — you can change it on the next step.</p>
  <p class="visually-hidden" aria-live="polite" data-announce></p>
</div>

<script>
  import '../scripts/climb.js';
</script>

<style>
  .climb { display: grid; gap: 20px; }
  .pickers { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 12px; }
  .pick-arrow { width: 20px; height: 20px; color: var(--muted); margin-block-end: 16px; }
  .queue { border: 0; padding: 5px; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; border-radius: 18px; background: rgba(0, 0, 0, .26); box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .08); }
  .queue label { position: relative; }
  .queue input { position: absolute; opacity: 0; inset: 0; margin: 0; }
  .queue span { display: block; padding: 12px; border-radius: 14px; text-align: center; font-size: .94rem; color: var(--muted); cursor: pointer; transition: background-color .3s, color .3s, box-shadow .3s; }
  .queue b { font-weight: 400; color: var(--text-strong); }
  .queue input:checked + span { background: rgba(196, 181, 253, .14); color: var(--text); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .45); }
  .queue input:focus-visible + span { outline: 1.5px solid var(--lav); outline-offset: 2px; }
  .result { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding-block-start: 22px; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .08); }
  .route { font-size: 1.02rem; color: var(--text-strong); }
  .meta { font-size: .86rem; color: var(--muted); }
  .price { font-size: clamp(2.8rem, 3vw + 1.6rem, 3.6rem); line-height: .9; font-weight: 400; color: var(--text-strong); }
  .fine { font-size: .84rem; color: var(--muted); text-align: center; }
  @media (max-width: 420px) {
    .pickers { grid-template-columns: 1fr 1fr; }
    .pick-arrow { display: none; }
    .queue span { font-size: .88rem; padding: 11px 6px; }
  }
</style>
