---
import { DISCORD } from '../data/site.js';
import { UI } from '../i18n/ui.js';
interface Props { active?: string; overlay?: boolean; lang?: 'en' | 'ar'; alternates?: { en?: string; ar?: string } }
// overlay: floats transparent over a full-screen scene (home), turns to glass once you scroll
const { active = '', overlay = false, lang = 'en', alternates = {} } = Astro.props;
const t = UI[lang];
const other = lang === 'ar' ? 'en' : 'ar';
const otherHref = alternates[other] || UI[other].homeHref;
---
<header class:list={['nav', { overlay }]} data-nav>
  <div class="nav-inner">
    <div class="side">
      <button class="burger" type="button" aria-label={t.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span><span></span><span></span>
      </button>
      <nav class="links" aria-label="Main">
        {t.nav.map((l) => <a href={l.href} aria-current={active === l.href ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </div>
    <a href={t.homeHref} class="mark" lang="en" aria-label="StainBoost home">STAINBOOST</a>
    <div class="side end">
      <a href={otherHref} class="lang-link" lang={other} hreflang={other} aria-label={t.otherLangLabel}>{t.otherLang}</a>
      <a href="/login" class="auth-link" data-auth-link data-signin={t.signIn} data-dash={t.dashboard}>{t.signIn}</a>
      <a href="/pricing" class="nav-cta" data-track="cta_click" data-track-location="nav">{t.order}</a>
    </div>
  </div>
  <div class="menu" id="mobile-menu" hidden data-menu>
    <nav aria-label="Mobile">
      <a href={t.homeHref}>{t.home}</a>
      {t.nav.map((l) => <a href={l.href} aria-current={active === l.href ? 'page' : undefined}>{l.label}</a>)}
      <a href="/login" data-auth-link data-signin={t.signIn} data-dash={t.dashboard}>{t.signIn}</a>
      <a href={otherHref} lang={other} hreflang={other}>{t.otherLang}</a>
      <a href={DISCORD.invite} target="_blank" rel="noopener">Discord</a>
    </nav>
    <a href="/pricing" class="btn btn-primary btn-lg btn-block" data-track="cta_click" data-track-location="menu">{t.seePrice}</a>
  </div>
</header>

<style>
  .nav {
    position: sticky; inset-block-start: 0; z-index: 50; height: var(--nav-h);
    background: rgba(8, 6, 26, .86); box-shadow: inset 0 -1px 0 rgba(246, 242, 255, .07);
    transition: background-color .5s var(--ease), box-shadow .5s;
  }
  @media (min-width: 900px) and (hover: hover) { .nav { background: rgba(8, 6, 26, .62); -webkit-backdrop-filter: blur(16px) saturate(1.2); backdrop-filter: blur(16px) saturate(1.2); } }
  .nav.overlay { position: relative; background: transparent; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
  :global(.nav-scrolled) .nav.overlay { background: rgba(8, 6, 26, .78); box-shadow: inset 0 -1px 0 rgba(246, 242, 255, .07); }
  @media (min-width: 900px) and (hover: hover) { :global(.nav-scrolled) .nav.overlay { background: rgba(8, 6, 26, .55); -webkit-backdrop-filter: blur(16px) saturate(1.2); backdrop-filter: blur(16px) saturate(1.2); } }

  .nav-inner { height: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding-inline: clamp(20px, 3.2vw, 48px); }
  .side { display: flex; align-items: center; gap: clamp(22px, 2.4vw, 38px); }
  .side.end { justify-content: flex-end; }
  .mark { font-family: var(--font-display); font-weight: 400; font-size: 1.62rem; letter-spacing: .32em; padding-inline-start: .32em; line-height: 1; color: var(--text-strong); text-decoration: none; }
  .links { display: flex; gap: clamp(22px, 2.4vw, 38px); }
  .lang-link { font-size: .84rem; color: var(--lav); text-decoration: none; }
  .lang-link:hover { color: var(--lav-hi); }
  .links a, .auth-link { font-size: .84rem; letter-spacing: .1em; color: rgba(246, 242, 255, .78); text-decoration: none; transition: color .3s; }
  .links a:hover, .auth-link:hover, .links a[aria-current='page'] { color: var(--text-strong); }
  .links a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--lav); text-underline-offset: 8px; }
  .nav-cta { padding: 9px 20px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .32); font-size: .84rem; letter-spacing: .1em; color: var(--text-strong); text-decoration: none; transition: box-shadow .3s, background-color .3s; }
  .nav-cta:hover { box-shadow: inset 0 0 0 1px var(--lav); background: rgba(196, 181, 253, .08); }

  .burger { display: none; width: 40px; height: 40px; margin-inline-start: -8px; border: 0; background: none; align-items: center; justify-content: center; flex-direction: column; gap: 6px; }
  .burger span { width: 20px; height: 1.4px; background: var(--text-strong); transition: transform .35s var(--ease), opacity .2s; }
  .burger span:nth-child(3) { width: 14px; align-self: center; transform: translateX(-3px); }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.4px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { width: 20px; transform: translateY(-7.4px) rotate(-45deg); }

  .menu { position: fixed; inset: var(--nav-h) 0 0; z-index: 49; background: rgba(8, 6, 26, .97); padding: 28px clamp(20px, 5vw, 48px) 32px; display: flex; flex-direction: column; justify-content: space-between; overflow-y: auto; }
  .menu nav { display: grid; }
  .menu a:not(.btn) { font-family: var(--font-display); font-weight: 300; font-size: 2.1rem; line-height: 1.2; color: var(--text-strong); text-decoration: none; padding-block: .45rem; }
  .menu a[aria-current='page'] { font-style: italic; color: var(--lav-hi); }

  @media (max-width: 900px) {
    .links, .auth-link, .lang-link { display: none; }
    .burger { display: inline-flex; }
    .mark { font-size: 1.32rem; letter-spacing: .24em; padding-inline-start: .24em; }
    .nav-cta { padding: 7px 15px; font-size: .78rem; }
  }
  @media (max-width: 400px) { .mark { letter-spacing: .2em; padding-inline-start: .2em; font-size: 1.2rem; } }
  @media (max-width: 359px) { .mark { letter-spacing: .14em; padding-inline-start: .14em; font-size: 1.1rem; } }
  :global(.is-minimal) .nav-cta { display: none; }
  :global(.menu-open) .nav { background: rgba(8, 6, 26, .97); }
  :global(.menu-open) body { overflow: hidden; }
</style>
