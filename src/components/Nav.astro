---
import { NAV, DISCORD } from '../data/site.js';
interface Props { active?: string }
const { active = '' } = Astro.props;
---
<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a href="/" class="logo" aria-label="StainBoost home">STAINBOOST</a>
    <nav class="links" aria-label="Main">
      {NAV.map((l) => <a href={l.href} aria-current={active === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a href="/login" class="auth-link" data-auth-link>Sign in</a>
      <a href="/pricing" class="btn btn-primary btn-sm nav-cta" data-track="cta_click" data-track-location="nav">Order now</a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="menu" id="mobile-menu" hidden data-menu>
    <nav class="wrap" aria-label="Mobile">
      <a href="/">Home</a>
      {NAV.map((l) => <a href={l.href} aria-current={active === l.href ? 'page' : undefined}>{l.label}</a>)}
      <a href="/login" data-auth-link>Sign in</a>
      <a href={DISCORD.invite} target="_blank" rel="noopener">Discord</a>
      <a href="/pricing" class="btn btn-primary btn-block" data-track="cta_click" data-track-location="menu">Order now</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; inset-block-start: 0; z-index: 50; height: var(--nav-h);
    background: rgba(6, 4, 17, 0.94); border-block-end: 1px solid rgba(139, 92, 246, 0.16);
  }
  @media (min-width: 900px) and (hover: hover) { .nav { background: rgba(6, 4, 17, 0.82); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); } }
  .nav::before { content: ''; position: absolute; inset-inline: 0; inset-block-start: 0; height: 2px; background: linear-gradient(90deg, transparent, rgba(124, 58, 237, .7) 30%, rgba(6, 214, 242, .6) 70%, transparent); }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 1.5rem; }
  .logo {
    font-family: var(--font-display); font-weight: 900; font-size: 1.12rem; letter-spacing: .14em; text-decoration: none;
    background: linear-gradient(120deg, var(--purple-light), var(--cyan)); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .links { display: flex; gap: .25rem; margin-inline-start: auto; }
  .links a, .auth-link {
    position: relative; font-family: var(--font-ui); font-weight: 700; font-size: .92rem; letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255, 255, 255, .7); text-decoration: none; padding: .5rem .8rem; border-radius: 8px; transition: color .2s, background-color .2s;
  }
  .links a::after { content: ''; position: absolute; inset-inline: .8rem; inset-block-end: 2px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--purple), var(--cyan)); transform: scaleX(0); transition: transform .3s var(--ease); }
  .links a:hover, .auth-link:hover { color: #fff; background: rgba(255, 255, 255, .05); }
  .links a:hover::after, .links a[aria-current='page']::after { transform: scaleX(1); }
  .links a[aria-current='page'] { color: var(--purple-light); }
  .actions { display: flex; align-items: center; gap: .6rem; }
  .burger { display: none; width: 44px; height: 44px; border: 1px solid rgba(255, 255, 255, .14); border-radius: 12px; background: rgba(255, 255, 255, .04); align-items: center; justify-content: center; flex-direction: column; gap: 5px; }
  .burger span { width: 18px; height: 2px; border-radius: 2px; background: #fff; transition: transform .25s var(--ease), opacity .2s; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu { position: absolute; inset-inline: 0; inset-block-start: var(--nav-h); background: rgba(6, 4, 17, .97); border-block-end: 1px solid var(--border); padding-block: .75rem 1.25rem; box-shadow: 0 30px 60px -20px #000; }
  .menu nav { display: grid; gap: .25rem; }
  .menu a:not(.btn) { font-family: var(--font-ui); font-weight: 700; font-size: 1.1rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text); text-decoration: none; padding: .8rem .5rem; border-block-end: 1px solid rgba(255, 255, 255, .06); }
  .menu a[aria-current='page'] { color: var(--purple-light); }
  .menu .btn { margin-block-start: .75rem; }
  @media (max-width: 860px) {
    .links, .auth-link { display: none; }
    .burger { display: inline-flex; }
    .actions { margin-inline-start: auto; }
  }
  @media (max-width: 380px) { .nav-cta { display: none; } }
  :global(.is-minimal) .nav-cta { display: none; }
</style>
