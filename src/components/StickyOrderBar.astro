---
// Phones only: an order bar that appears once the main CTA scrolls away.
// Follows the hero quote if the visitor changed it (sb:quote event).
interface Props { label: string; price: string; href: string; cta?: string; watch?: string }
const { label, price, href, cta = 'Order', watch = '[data-climb]' } = Astro.props;
---
<div class="sticky" data-sticky data-watch={watch} hidden data-loc="sticky_bar">
  <div class="info">
    <span class="lbl" data-sticky-label>{label}</span>
    <span class="price num" data-sticky-price>{price}</span>
  </div>
  <a class="btn btn-primary" href={href} data-sticky-cta data-track="cta_click" data-track-location="sticky_bar">{cta}</a>
</div>

<script>
  const bar = document.querySelector('[data-sticky]');
  if (bar) {
    // hidden while any watched element (e.g. the hero, the price card's button) or the footer is on screen
    const targets = [...document.querySelectorAll(bar.getAttribute('data-watch'))];
    const footer = document.querySelector('footer');
    const visible = new Set(targets);
    let footerVisible = false;
    const sync = () => { bar.hidden = visible.size > 0 || footerVisible; };
    if (targets.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target))); sync(); });
      targets.forEach((t) => io.observe(t));
      if (footer) new IntersectionObserver(([e]) => { footerVisible = e.isIntersecting; sync(); }).observe(footer);
    }
    document.addEventListener('sb:quote', (e) => {
      const d = e.detail;
      bar.querySelector('[data-sticky-label]').textContent = d.label;
      bar.querySelector('[data-sticky-price]').textContent = '$' + d.total.toFixed(2);
      bar.querySelector('[data-sticky-cta]').setAttribute('href', d.href);
    });
  }
</script>

<style>
.sticky { display: none; }
  @media (max-width: 760px) {
    .sticky:not([hidden]) {
      position: fixed; z-index: 55; inset-inline: 12px; inset-block-end: calc(12px + env(safe-area-inset-bottom));
      display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 8px 8px 20px;
      border-radius: 999px; background: rgba(14, 10, 34, .94);
      box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .14), 0 20px 40px -16px rgba(0, 0, 0, .9);
      animation: up .5s var(--ease);
    }
    .info { display: grid; line-height: 1.15; min-width: 0; }
    .lbl { font-size: .78rem; letter-spacing: .04em; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .price { font-size: 1.45rem; color: var(--text-strong); }
    .btn { --h: 44px; padding: 0 1.3rem; }
  }
  @keyframes up { from { transform: translateY(140%); } }
</style>
