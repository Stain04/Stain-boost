---
import { TIER_STYLE } from '../data/ranks.js';
interface Props { tier: string; size?: number; class?: string }
const { tier, size = 40, class: cls = '' } = Astro.props;
const t = TIER_STYLE[tier] ?? TIER_STYLE.Iron;
---
<svg class={`emblem ${cls}`} viewBox="0 0 48 48" width={size} height={size} style={`color:${t.color}`} aria-hidden="true">
  <polygon points={t.shape} fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  <polygon points={t.shape} transform="translate(24 24) scale(.52) translate(-24 -24)" fill="currentColor" fill-opacity=".6" />
  <circle cx="24" cy="24" r="2.6" fill="#fff" fill-opacity=".85" />
</svg>
