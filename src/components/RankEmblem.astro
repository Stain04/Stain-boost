---
// A League rank emblem (public/img/ranks/, 4:3). `size` is the width in CSS px.
// Above-the-fold pickers pass loading="eager" so a newly picked rank never shows a gap.
import { RANK_IMAGES } from '../data/ranks.js';
interface Props { tier: string; size?: number; class?: string; loading?: 'lazy' | 'eager' }
const { tier, size = 40, class: cls = '', loading = 'lazy' } = Astro.props;
const file = RANK_IMAGES[tier] ?? 'iron';
---
<img class={`emblem ${cls}`} src={`/img/ranks/${file}.webp`} width={size} height={Math.round(size * 0.75)} alt="" loading={loading} decoding="async" fetchpriority="low" />
