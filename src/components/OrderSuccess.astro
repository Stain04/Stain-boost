---
// Shown after an order is placed (filled in by configurator.js).
// Payment methods come from src/data/site.js — methods without details are hidden.
import { PAYMENT_METHODS, DISCORD } from '../data/site.js';
const methods = PAYMENT_METHODS.filter((m) => m.id || m.link);
---
<section class="success" data-success hidden tabindex="-1" aria-labelledby="succ-title" data-loc="order_success">
  <div class="card succ-card">
    <div class="succ-head">
      <span class="tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg></span>
      <div>
        <p class="eyebrow">Order placed</p>
        <h2 id="succ-title"><span data-succ-route>Your boost</span> — <span class="gold num" data-succ-total>$0.00</span></h2>
        <p class="muted">Order <strong class="tok" data-succ-token>SB-XXXX-XXXX</strong> · status: awaiting payment. The boost starts as soon as payment is confirmed.</p>
      </div>
    </div>

    <ol class="next">
      <li>
        <span class="n">1</span>
        <div class="body">
          <h3>Pay</h3>
          {methods.length > 0 ? (
            <div class="pay" data-pay>
              <div class="pay-tabs" role="radiogroup" aria-label="Payment method">
                {methods.map((m, i) => <label><input type="radio" name="payMethod" value={m.key} checked={i === 0} /><span>{m.name}</span></label>)}
              </div>
              {methods.map((m, i) => (
                <div class="pay-panel" data-pay-panel={m.key} hidden={i !== 0}>
                  <p class="amount">Send <b class="gold num" data-pay-amount>$0.00</b></p>
                  {m.id && (
                    <div class="copy-row">
                      <span class="label">{m.idLabel}</span>
                      <code>{m.id}</code>
                      <button type="button" class="btn btn-ghost btn-sm" data-copy={m.id} data-copy-what={m.key + '_id'}>Copy</button>
                    </div>
                  )}
                  {m.link && <a class="btn btn-primary btn-sm" href={m.link.replace('{amount}', '')} data-pay-link={m.link} target="_blank" rel="noopener" data-track="pay_link_click" data-track-location={m.key}>Pay with {m.name} ↗</a>}
                  <p class="hint">{m.note}</p>
                  <button type="button" class="btn btn-gold btn-sm" data-paid={m.key}>I've paid with {m.name}</button>
                </div>
              ))}
              <p class="hint" data-paid-msg aria-live="polite"></p>
              <p class="other">Can't use {methods.map((m) => m.name).join(' or ')}? Message <strong>{DISCORD.handle}</strong> on Discord and Stain will sort out another way to pay.</p>
            </div>
          ) : (
            <p>Message <strong>{DISCORD.handle}</strong> on Discord and Stain sends you the payment details.</p>
          )}
        </div>
      </li>
      <li>
        <span class="n">2</span>
        <div class="body">
          <h3>Say hi on Discord</h3>
          <p>Add <strong>{DISCORD.handle}</strong> and paste your order message — Stain usually replies within minutes.</p>
          <div class="row">
            <button type="button" class="btn btn-ghost btn-sm" data-copy={DISCORD.handle} data-copy-what="discord_handle">Copy “{DISCORD.handle}”</button>
            <button type="button" class="btn btn-ghost btn-sm" data-copy-msg>Copy my order message</button>
            <a class="btn btn-discord btn-sm" href={DISCORD.invite} target="_blank" rel="noopener">Open Discord</a>
          </div>
        </div>
      </li>
      <li>
        <span class="n">3</span>
        <div class="body">
          <h3>Track it live</h3>
          <p>Every game, your rank and LP, notes and a direct chat with Stain.</p>
          <div class="row">
            <a class="btn btn-primary btn-sm" href="/dashboard" data-succ-track>Open my order tracker</a>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .success { scroll-margin-top: calc(var(--nav-h) + 20px); }
  .succ-card { display: grid; gap: 22px; border-color: rgba(52, 211, 153, .4); box-shadow: 0 30px 80px -34px rgba(52, 211, 153, .35); }
  .succ-head { display: flex; gap: 16px; align-items: flex-start; }
  .tick { width: 52px; height: 52px; flex: none; border-radius: 50%; display: grid; place-items: center; color: #062; background: var(--success); box-shadow: 0 0 30px rgba(52, 211, 153, .55); }
  .tick svg { width: 26px; height: 26px; }
  .succ-head h2 { font-size: clamp(1.3rem, 1.5vw + 1rem, 1.8rem); margin-block: 4px; }
  .tok { font-family: ui-monospace, monospace; color: #fff; letter-spacing: .04em; }
  .next { list-style: none; padding: 0; display: grid; gap: 14px; }
  .next > li { display: flex; gap: 14px; padding: 16px; border-radius: 16px; background: rgba(255, 255, 255, .03); border: 1px solid rgba(255, 255, 255, .08); }
  .next .n { width: 32px; height: 32px; flex: none; border-radius: 10px; display: grid; place-items: center; font-family: var(--font-display); font-weight: 900; font-size: .85rem; color: var(--cyan); background: rgba(6, 214, 242, .08); border: 1px solid rgba(6, 214, 242, .3); }
  .body { display: grid; gap: 10px; flex: 1; min-width: 0; }
  .body h3 { font-family: var(--font-ui); font-size: 1.2rem; letter-spacing: .04em; }
  .body p { color: rgba(255, 255, 255, .75); }
  .body strong { color: #fff; }
  .pay-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .pay-tabs label { position: relative; }
  .pay-tabs input { position: absolute; opacity: 0; inset: 0; }
  .pay-tabs span { display: inline-block; padding: 8px 14px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, .14); font-family: var(--font-ui); font-weight: 700; letter-spacing: .06em; cursor: pointer; }
  .pay-tabs input:checked + span { border-color: var(--gold); color: var(--gold); background: rgba(245, 166, 35, .08); }
  .pay-tabs input:focus-visible + span { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .pay-panel { display: grid; gap: 10px; justify-items: start; padding-block-start: 6px; }
  .amount { font-family: var(--font-ui); font-weight: 700; font-size: 1.1rem; }
  .copy-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .other { font-size: .9rem; padding-block-start: 10px; border-block-start: 1px solid rgba(255, 255, 255, .08); }
  code { font-family: ui-monospace, monospace; font-size: 1rem; padding: 6px 10px; border-radius: 8px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); color: #fff; }
</style>
