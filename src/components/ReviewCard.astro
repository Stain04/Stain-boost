---
interface Props { name: string; rank?: string; stars: number; date?: string; text: string; delay?: number }
const { name, rank = '', stars, date = '', text, delay = 0 } = Astro.props;
const initials = name.trim().split(/[\s_.-]+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase() || '?';
---
<figure class="review card card-glow reveal" style={`--d:${delay}s`}>
  <div class="top">
    <span class="stars" role="img" aria-label={`${stars} out of 5 stars`}>{'★'.repeat(stars)}<span class="dim">{'★'.repeat(5 - stars)}</span></span>
    {date && <span class="date">{date}</span>}
  </div>
  {rank && <p class="rank">{rank}</p>}
  <blockquote>{text}</blockquote>
  <figcaption>
    <span class="ava" aria-hidden="true">{initials}</span>
    <span><span class="name">{name}</span><span class="verified">✓ Verified order</span></span>
  </figcaption>
</figure>

<style>
  .review { display: flex; flex-direction: column; gap: 12px; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .stars { color: var(--gold); letter-spacing: 2px; font-size: 1rem; text-shadow: 0 0 12px rgba(245, 166, 35, .35); }
  .dim { color: rgba(255, 255, 255, .15); text-shadow: none; }
  .date { font-family: var(--font-ui); font-weight: 600; font-size: .8rem; color: var(--muted); letter-spacing: .06em; }
  .rank { align-self: start; font-family: var(--font-ui); font-weight: 700; font-size: .8rem; letter-spacing: .08em; color: var(--purple-light); background: rgba(124, 58, 237, .12); border: 1px solid rgba(139, 92, 246, .3); border-radius: 8px; padding: .2rem .6rem; }
  blockquote { flex: 1; color: rgba(255, 255, 255, .82); font-size: 1rem; line-height: 1.6; }
  figcaption { display: flex; align-items: center; gap: 10px; }
  .ava { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-ui); font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--purple), var(--cyan)); flex: none; }
  .name { display: block; font-family: var(--font-ui); font-weight: 700; font-size: 1rem; color: #fff; }
  .verified { display: block; font-size: .78rem; color: var(--success); font-weight: 600; }
</style>
