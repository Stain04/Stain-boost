---
interface Props { name: string; rank?: string; stars: number; date?: string; text: string; delay?: number }
const { name, rank = '', stars, date = '', text, delay = 0 } = Astro.props;
const initials = name.trim().split(/[\s_.-]+/).map((p) => p[0]).join('').slice(0, 2).toUpperCase() || '?';
---
<figure class="review card card-glow reveal" style={`--d:${delay}s`}>
  <div class="top">
    <span class="stars" role="img" aria-label={`${stars} out of 5 stars`}>{'★'.repeat(stars)}<span class="dim">{'★'.repeat(5 - stars)}</span></span>
    {date && <span class="date">{date}</span>}
  </div>
  {rank && <p class="rank">{rank}</p>}
  <blockquote>{text}</blockquote>
  <figcaption>
    <span class="ava" aria-hidden="true">{initials}</span>
    <span><span class="name">{name}</span><span class="verified">✓ Verified order</span></span>
  </figcaption>
</figure>

<style>
.review { display: flex; flex-direction: column; gap: 16px; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .stars { color: var(--gold); letter-spacing: 3px; font-size: .9rem; }
  .dim { color: rgba(246, 242, 255, .15); }
  .date { font-size: .78rem; color: var(--muted); letter-spacing: .14em; text-transform: uppercase; }
  .rank { font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--lav); }
  blockquote { flex: 1; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 1.42rem; line-height: 1.35; color: var(--text-strong); }
  figcaption { display: flex; align-items: center; gap: 12px; padding-block-start: 14px; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .07); }
  .ava { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: .8rem; letter-spacing: .06em; color: var(--lav-hi); box-shadow: inset 0 0 0 1px rgba(196, 181, 253, .4); flex: none; }
  .name { display: block; font-weight: 400; font-size: .98rem; color: var(--text-strong); }
  .verified { display: block; font-size: .78rem; color: var(--success); letter-spacing: .04em; }
</style>
