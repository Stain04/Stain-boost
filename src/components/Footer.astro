---
import { DISCORD } from '../data/site.js';
import { UI } from '../i18n/ui.js';
interface Props { lang?: 'en' | 'ar' }
const { lang = 'en' } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-grid">
    <div class="brand">
      <a href={t.homeHref} class="logo" lang="en">STAINBOOST</a>
      <p class="muted">{t.footerAbout}</p>
      <a class="btn btn-ghost btn-sm" href={DISCORD.invite} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 2.9l-.6 1.3a18.3 18.3 0 0 0-5.5 0l-.6-1.3a19.7 19.7 0 0 0-4.9 1.5C.7 9-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2a13 13 0 0 1-1.9-.9l.4-.3a14.2 14.2 0 0 0 12.1 0l.4.3c-.6.4-1.2.7-1.9.9l1.3 2a19.9 19.9 0 0 0 6-3c.5-5.2-.8-9.7-3.5-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.5 8 10.5s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
        <span lang="en">Discord · {DISCORD.handle}</span>
      </a>
    </div>
    {t.footerCols.map((col) => (
      <nav aria-label={col.title}>
        <p class="col-title">{col.title}</p>
        {col.links.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    ))}
  </div>
  <div class="wrap legal">
    <p>{t.legal(year)}</p>
  </div>
</footer>

<style>
  .footer { position: relative; margin-block-start: clamp(48px, 9vw, 110px); padding-block: clamp(56px, 7vw, 88px) 32px; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .07); }
  .footer-grid { display: grid; gap: 40px; grid-template-columns: 1.6fr repeat(4, 1fr); }
  .brand { display: grid; gap: 16px; justify-items: start; max-width: 380px; }
  .logo { font-family: var(--font-display); font-weight: 400; letter-spacing: .32em; font-size: 1.5rem; text-decoration: none; color: var(--text-strong); }
  .brand p { font-size: .98rem; line-height: 1.65; }
  .brand .btn svg { width: 16px; height: 16px; color: #8b93ff; }
  nav { display: grid; gap: .7rem; align-content: start; }
  .col-title { font-weight: 400; letter-spacing: .24em; text-transform: uppercase; font-size: .72rem; color: var(--lav); margin-block-end: .3rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: .98rem; transition: color .3s; }
  nav a:hover { color: var(--text-strong); }
  .legal { margin-block-start: 48px; padding-block-start: 22px; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .06); }
  .legal p { font-size: .82rem; color: var(--muted); }
  @media (max-width: 1000px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } .brand { grid-column: 1 / -1; } }
</style>
