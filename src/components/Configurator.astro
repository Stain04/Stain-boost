---
// Order settings (left side of /pricing), laid out the way the big boosting sites do it:
// service tabs, current rank and desired rank side by side, then server and LP.
// The order box on the right is OrderSummary.astro; src/scripts/configurator.js makes both live.
import RankEmblem from './RankEmblem.astro';
import { WIN_PRICES, RB_TIERS, RB_DIVS, MASTERS, LP_OPTIONS, MAX_WINS, divisionPrice, formatUSD, lowestWinPrice } from '../data/pricing.js';
import { REGIONS } from '../data/site.js';
import { tierOfWinRank } from '../data/ranks.js';

const def = { fromTier: 2, fromDiv: 2, toTier: 3, toDiv: 0 };
const defLp = LP_OPTIONS[0].value;
const winRanks = Object.keys(WIN_PRICES);
const servers = REGIONS.filter((r) => r.live);
const divName = (t, d) => (t === MASTERS ? 'Master' : `${RB_TIERS[t]} ${RB_DIVS[d]}`);
---
<form class="cfg" data-cfg novalidate data-loc="configurator">
  <div class="svc" role="radiogroup" aria-label="Type of boost">
    <label class="svc-tab"><input type="radio" name="mode" value="rank" checked /><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 17 6-6 4 4 8-8" /><path d="M14 7h7v7" /></svg>Rank boost<small>from {formatUSD(divisionPrice(0, 0, 'solo'))}/division</small></span></label>
    <label class="svc-tab"><input type="radio" name="mode" value="wins" /><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z" /><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3" /></svg>Net wins<small>from {formatUSD(lowestWinPrice())}/win · pay 5, get 6</small></span></label>
  </div>

  <!-- RANK BOOST -->
  <div class="ranks" data-show="rank">
    <fieldset class="rank-box">
      <legend class="visually-hidden">Current rank</legend>
      <div class="rb-head">
        <span class="rb-emblem">{RB_TIERS.map((t, i) => <span data-from-emblem={i} hidden={i !== def.fromTier}><RankEmblem tier={t} size={52} /></span>)}</span>
        <span class="rb-title"><small>Current rank</small><b data-from-name>{divName(def.fromTier, def.fromDiv)}</b></span>
      </div>
      <div class="tiers" role="radiogroup" aria-label="Current tier">
        {RB_TIERS.slice(0, MASTERS).map((t, i) => (
          <label class="tier" title={t}><input type="radio" name="fromTier" value={i} checked={i === def.fromTier} /><span><RankEmblem tier={t} size={30} /><b>{t}</b></span></label>
        ))}
      </div>
      <div class="seg divs" role="radiogroup" aria-label="Current division">
        {RB_DIVS.map((d, i) => <label><input type="radio" name="fromDiv" value={i} checked={i === def.fromDiv} /><span>{d}</span></label>)}
      </div>
      <label class="field-sel">
        <span>LP in this division</span>
        <select name="lp" class="sel" data-lp-select>
          {LP_OPTIONS.map((o) => <option value={o.value} selected={o.value === defLp}>{o.label}</option>)}
        </select>
      </label>
    </fieldset>

    <span class="rb-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>

    <fieldset class="rank-box">
      <legend class="visually-hidden">Desired rank</legend>
      <div class="rb-head">
        <span class="rb-emblem">{RB_TIERS.map((t, i) => <span data-to-emblem={i} hidden={i !== def.toTier}><RankEmblem tier={t} size={52} /></span>)}</span>
        <span class="rb-title"><small>Desired rank</small><b data-to-name>{divName(def.toTier, def.toDiv)}</b></span>
      </div>
      <div class="tiers" role="radiogroup" aria-label="Desired tier">
        {RB_TIERS.map((t, i) => (
          <label class="tier" title={t}><input type="radio" name="toTier" value={i} checked={i === def.toTier} disabled={i < def.fromTier} /><span><RankEmblem tier={t} size={30} /><b>{t}</b></span></label>
        ))}
      </div>
      <div class="seg divs" role="radiogroup" aria-label="Desired division" data-to-div>
        {RB_DIVS.map((d, i) => <label><input type="radio" name="toDiv" value={i} checked={i === def.toDiv} /><span>{d}</span></label>)}
      </div>
    </fieldset>
  </div>

  <!-- NET WINS -->
  <div class="winsbox" data-show="wins" hidden>
    <fieldset class="rank-box">
      <legend class="rb-label">Your current rank</legend>
      <div class="wranks" role="radiogroup" aria-label="Current rank">
        {winRanks.map((r, i) => (
          <label class="wrank"><input type="radio" name="winRank" value={i} checked={r === 'Gold'} /><span><RankEmblem tier={tierOfWinRank(r)} size={30} /><b>{r.replace('-', '–')}</b><small data-win-price={r}>{formatUSD(WIN_PRICES[r].solo)}/win</small></span></label>
        ))}
      </div>
    </fieldset>
    <fieldset class="rank-box">
      <legend class="rb-label">Net wins you pay for</legend>
      <div class="wins">
        <button type="button" class="wbtn" data-wins-step="-1" aria-label="One win less">−</button>
        <label class="visually-hidden" for="wins">Net wins</label>
        <input id="wins" name="wins" type="number" inputmode="numeric" min="1" max={MAX_WINS} value="5" class="wins-input num" />
        <button type="button" class="wbtn" data-wins-step="1" aria-label="One win more">+</button>
        <div class="wins-get" data-wins-get>You get <b>6 wins</b> <span class="gold">(1 free)</span></div>
      </div>
      <div class="chips" data-wins-chips>
        {[3, 5, 10, 15, 20].map((n) => <button type="button" class="wchip" data-wins={n}>{n}{n >= 5 && <span class="free">+{Math.floor(n / 5)} free</span>}</button>)}
      </div>
      <p class="hint">Only net wins count (wins minus losses), so Stain plays until every win is in.</p>
    </fieldset>
  </div>

  <div class="opts">
    <label class="field-sel">
      <span>Server</span>
      <select name="region" class="sel">
        {servers.map((r) => <option value={r.code} selected={r.code === 'me'}>{r.name} ({r.code.toUpperCase()})</option>)}
      </select>
    </label>
    <p class="opts-note">Same price on every server.</p>
  </div>
</form>
