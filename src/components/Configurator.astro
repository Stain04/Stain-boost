---
// Price calculator (left side of /pricing). Server-rendered with the default order
// (Silver II → Gold IV, solo, ME); src/scripts/configurator.js makes it live.
// The checkout box on the right is OrderSummary.astro. All prices come from src/data/pricing.js.
import RankEmblem from './RankEmblem.astro';
import { WIN_PRICES, RB_TIERS, RB_DIVS, MASTERS, LP_OPTIONS, MAX_WINS, divisionPrice, formatUSD } from '../data/pricing.js';
import { REGIONS } from '../data/site.js';
import { tierOfWinRank } from '../data/ranks.js';

const def = { fromTier: 2, fromDiv: 2, toTier: 3, toDiv: 0 };
const defLp = LP_OPTIONS[0].value;
const winRanks = Object.keys(WIN_PRICES);
const minDiv = divisionPrice(0, 0, 'solo');
const servers = REGIONS.filter((r) => r.live);
---
<form class="cfg calc card" data-cfg novalidate data-loc="configurator">
  <div class="tabs" role="radiogroup" aria-label="Type of boost">
    <label class="tab"><input type="radio" name="mode" value="rank" checked /><span><b>Rank boost</b><small>From {formatUSD(minDiv)} per division</small></span></label>
    <label class="tab"><input type="radio" name="mode" value="wins" /><span><b>Net wins</b><small>Pay for 5, get 6</small></span></label>
  </div>

  <!-- RANK BOOST: from → to -->
  <div class="ranks" data-show="rank">
    <fieldset class="pick">
      <legend class="pick-title">Current rank</legend>
      <div class="tiers" role="radiogroup" aria-label="Current tier">
        {RB_TIERS.slice(0, MASTERS).map((t, i) => (
          <label class="tier"><input type="radio" name="fromTier" value={i} checked={i === def.fromTier} /><span><RankEmblem tier={t} size={30} /><b>{t}</b></span></label>
        ))}
      </div>
      <div class="seg divs" role="radiogroup" aria-label="Current division">
        {RB_DIVS.map((d, i) => <label><input type="radio" name="fromDiv" value={i} checked={i === def.fromDiv} /><span>{d}</span></label>)}
      </div>
    </fieldset>

    <span class="to-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>

    <fieldset class="pick">
      <legend class="pick-title">Desired rank</legend>
      <div class="tiers" role="radiogroup" aria-label="Desired tier">
        {RB_TIERS.map((t, i) => (
          <label class="tier"><input type="radio" name="toTier" value={i} checked={i === def.toTier} disabled={i < def.fromTier} /><span><RankEmblem tier={t} size={30} /><b>{t}</b></span></label>
        ))}
      </div>
      <div class="seg divs" role="radiogroup" aria-label="Desired division" data-to-div>
        {RB_DIVS.map((d, i) => <label><input type="radio" name="toDiv" value={i} checked={i === def.toDiv} /><span>{d}</span></label>)}
      </div>
    </fieldset>
  </div>

  <!-- NET WINS: rank + number of wins -->
  <div class="winsbox" data-show="wins" hidden>
    <fieldset class="pick">
      <legend class="pick-title">Your current rank</legend>
      <div class="wranks" role="radiogroup" aria-label="Current rank">
        {winRanks.map((r, i) => (
          <label class="wrank"><input type="radio" name="winRank" value={i} checked={r === 'Gold'} /><span><RankEmblem tier={tierOfWinRank(r)} size={28} /><b>{r.replace('-', '–')}</b><small data-win-price={r}>{formatUSD(WIN_PRICES[r].solo)}/win</small></span></label>
        ))}
      </div>
    </fieldset>
    <fieldset class="pick">
      <legend class="pick-title">Net wins you pay for</legend>
      <div class="wins">
        <button type="button" class="wbtn" data-wins-step="-1" aria-label="One win less">−</button>
        <label class="visually-hidden" for="wins">Net wins</label>
        <input id="wins" name="wins" type="number" inputmode="numeric" min="1" max={MAX_WINS} value="5" class="wins-input num" />
        <button type="button" class="wbtn" data-wins-step="1" aria-label="One win more">+</button>
        <div class="wins-get" data-wins-get>You get <b>6 wins</b> <span class="gold">(1 free)</span></div>
      </div>
      <div class="chips" data-wins-chips>
        {[3, 5, 10, 15, 20].map((n) => <button type="button" class="wchip" data-wins={n}>{n}{n >= 5 && <span class="free">+{Math.floor(n / 5)} free</span>}</button>)}
      </div>
      <p class="hint">Only net wins count (wins minus losses), so Stain plays until every win is in.</p>
    </fieldset>
  </div>

  <!-- QUEUE + SERVER -->
  <div class="opts">
    <div class="opt">
      <span class="opt-label" id="queueL">Queue</span>
      <div class="seg" role="radiogroup" aria-labelledby="queueL">
        <label><input type="radio" name="type" value="solo" checked /><span>Solo</span></label>
        <label><input type="radio" name="type" value="duo" /><span>Duo</span></label>
      </div>
      <p class="opt-hint" data-queue-hint>Stain plays on your account, in offline mode with a VPN matched to your country.</p>
    </div>
    <div class="opt">
      <span class="opt-label" id="serverL">Server</span>
      <div class="seg" role="radiogroup" aria-labelledby="serverL">
        {servers.map((r) => <label><input type="radio" name="region" value={r.code} checked={r.code === 'me'} /><span>{r.code.toUpperCase()}</span></label>)}
      </div>
      <p class="opt-hint">Same price on every server.</p>
    </div>
  </div>

  <!-- rarely needed: LP already earned in the current division -->
  <details class="more" data-show="rank">
    <summary>More options</summary>
    <div class="more-body">
      <p class="opt-label" id="lpL">LP in your current division <span class="hint-inline">— you only pay for the part left</span></p>
      <div class="seg seg-wrap" role="radiogroup" aria-labelledby="lpL">
        {LP_OPTIONS.map((o) => <label><input type="radio" name="lp" value={o.value} checked={o.value === defLp} /><span>{o.label}<small data-lp-save={o.value}></small></span></label>)}
      </div>
    </div>
  </details>
</form>
