---
// Native <details> accordion: works without JS, keyboard-accessible.
interface Props { items: { q: string; a: string }[]; loc?: string }
const { items, loc = 'faq' } = Astro.props;
---
<div class="faq" data-loc={loc}>
  {items.map((i) => (
    <details class="item" data-faq={i.q}>
      <summary><span>{i.q}</span><span class="icon" aria-hidden="true"></span></summary>
      <div class="answer" set:html={i.a} />
    </details>
  ))}
</div>

<script>
  import { track } from '../scripts/analytics.js';
  document.querySelectorAll('details[data-faq]').forEach((d) => {
    d.addEventListener('toggle', () => { if (d.open) track('faq_open', { question: d.dataset.faq, location: d.closest('[data-loc]')?.getAttribute('data-loc') || '' }); });
  });
</script>

<style>
.faq { display: grid; box-shadow: inset 0 1px 0 rgba(246, 242, 255, .1); }
  .item { box-shadow: inset 0 -1px 0 rgba(246, 242, 255, .1); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 2px; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.25rem, .5vw + 1.1rem, 1.5rem); line-height: 1.25; color: var(--text-strong); transition: color .3s; }
  summary:hover { color: var(--lav-hi); }
  summary::-webkit-details-marker { display: none; }
  .icon { position: relative; width: 28px; height: 28px; flex: none; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(246, 242, 255, .22); transition: box-shadow .3s; }
  .item[open] .icon { box-shadow: inset 0 0 0 1px var(--lav); }
  .icon::before, .icon::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: 11px; height: 1.2px; margin: -.6px 0 0 -5.5px; background: var(--lav); transition: transform .4s var(--ease); }
  .icon::after { transform: rotate(90deg); }
  .item[open] .icon::after { transform: rotate(0); }
  .answer { padding: 0 2px 24px; max-width: 68ch; color: var(--text); line-height: 1.75; }
  .answer :global(strong) { color: var(--text-strong); }
</style>
