---
// Native <details> accordion: works without JS, keyboard-accessible.
interface Props { items: { q: string; a: string }[]; loc?: string }
const { items, loc = 'faq' } = Astro.props;
---
<div class="faq" data-loc={loc}>
  {items.map((i) => (
    <details class="item" data-faq={i.q}>
      <summary><span>{i.q}</span><span class="icon" aria-hidden="true"></span></summary>
      <div class="answer" set:html={i.a} />
    </details>
  ))}
</div>

<script>
  import { track } from '../scripts/analytics.js';
  document.querySelectorAll('details[data-faq]').forEach((d) => {
    d.addEventListener('toggle', () => { if (d.open) track('faq_open', { question: d.dataset.faq, location: d.closest('[data-loc]')?.getAttribute('data-loc') || '' }); });
  });
</script>

<style>
  .faq { display: grid; gap: 10px; }
  .item { border: 1px solid rgba(255, 255, 255, .09); border-radius: 16px; background: var(--card); transition: border-color .25s, box-shadow .25s; }
  .item[open] { border-color: rgba(139, 92, 246, .4); box-shadow: 0 0 0 1px rgba(124, 58, 237, .15), 0 10px 30px -18px rgba(124, 58, 237, .6); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 18px; font-family: var(--font-ui); font-weight: 700; font-size: 1.1rem; letter-spacing: .02em; color: #fff; }
  summary::-webkit-details-marker { display: none; }
  .icon { position: relative; width: 26px; height: 26px; flex: none; border-radius: 8px; background: rgba(124, 58, 237, .14); border: 1px solid rgba(139, 92, 246, .3); }
  .icon::before, .icon::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: 11px; height: 2px; margin: -1px 0 0 -5.5px; background: var(--purple-light); border-radius: 2px; transition: transform .3s var(--ease); }
  .icon::after { transform: rotate(90deg); }
  .item[open] .icon::after { transform: rotate(0); }
  .answer { padding: 0 18px 18px; color: rgba(255, 255, 255, .78); line-height: 1.7; }
  .answer :global(strong) { color: #fff; }
</style>
