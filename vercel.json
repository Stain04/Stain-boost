{
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/how-to-climb-faster", "destination": "/blog/how-to-climb-faster", "permanent": true },
    { "source": "/elo-boosting-safe", "destination": "/blog/elo-boosting-safe", "permanent": true },
    { "source": "/best-champions-solo-queue", "destination": "/blog/best-champions-solo-queue", "permanent": true },
    { "source": "/what-is-elo-boosting", "destination": "/blog/what-is-elo-boosting", "permanent": true },
    { "source": "/how-to-escape-silver", "destination": "/blog/how-to-escape-silver", "permanent": true },
    { "source": "/master-yi-build-guide", "destination": "/blog/master-yi-build-guide", "permanent": true },
    { "source": "/how-to-reach-diamond", "destination": "/blog/how-to-reach-diamond", "permanent": true },
    { "source": "/is-elo-boosting-worth-it", "destination": "/blog/is-elo-boosting-worth-it", "permanent": true },
    { "source": "/why-am-i-hardstuck", "destination": "/blog/why-am-i-hardstuck", "permanent": true },
    { "source": "/how-to-escape-gold", "destination": "/blog/how-to-escape-gold", "permanent": true },
    { "source": "/what-is-mmr-league-of-legends", "destination": "/blog/what-is-mmr-league-of-legends", "permanent": true },
    { "source": "/how-to-reach-emerald", "destination": "/blog/how-to-reach-emerald", "permanent": true },
    { "source": "/best-times-to-play-ranked", "destination": "/blog/best-times-to-play-ranked", "permanent": true }
  ],
  "rewrites": [
    { "source": "/track/:token", "destination": "/track" },
    { "source": "/review/:token", "destination": "/review" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://ddragon.leagueoflegends.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://vitals.vercel-insights.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(fonts|_astro)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(img|og)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
